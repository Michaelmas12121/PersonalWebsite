---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: { src: ImageMetadata; alt: string; fit?: "cover" | "contain"; position?: string }[];
  label: string;
  rhythm?: number;
  sizes?: string;
  controls?: boolean;
}

const { images, label, rhythm = 0, sizes = "(max-width: 680px) 90vw, 35vw", controls = false } = Astro.props;
// Larger collections move faster, with a quiet lower bound and distinct phases.
const interval = Math.round(1800 + 6000 / (images.length + 1) + rhythm * 45);
const frames = await Promise.all(images.map(async (frame) => {
  const small = await getImage({ src: frame.src, width: Math.min(400, frame.src.width), format: "webp" });
  const large = await getImage({ src: frame.src, width: Math.min(960, frame.src.width), format: "webp" });
  return { ...frame, url: large.src, srcset: `${small.src} ${small.options.width}w, ${large.src} ${large.options.width}w` };
}));
---

<image-window
  role="group"
  aria-label={`${label} photographs`}
  aria-roledescription={frames.length > 1 ? "carousel" : undefined}
  data-interval={interval}
  data-delay={interval + rhythm * 180}
>
  <div class="window-viewport">
    {frames.map((frame, index) => (
      <div class:list={["window-frame", { "is-current": index === 0 }]} aria-hidden={index !== 0}>
        <img
          src={index === 0 ? frame.url : undefined}
          srcset={index === 0 ? frame.srcset : undefined}
          data-src={frame.url}
          data-srcset={frame.srcset}
          sizes={sizes}
          alt={frame.alt}
          width={frame.src.width}
          height={frame.src.height}
          loading="lazy"
          decoding="async"
          style={`object-fit: ${frame.fit ?? "contain"}; object-position: ${frame.position ?? "50% 50%"}`}
        />
      </div>
    ))}
  </div>
  {controls && <div class="window-controls">
    <button type="button" data-image-back aria-label="Previous photograph" disabled={frames.length < 2}>←</button>
    <span data-image-count>1 / {frames.length}</span>
    <button type="button" data-image-next aria-label="Next photograph" disabled={frames.length < 2}>→</button>
    {frames.length > 1 && <button type="button" data-image-pause aria-label="Pause photograph slideshow">Pause</button>}
  </div>}
</image-window>

<script>
  class ImageWindow extends HTMLElement {
    connectedCallback() {
      const frames = [...this.querySelectorAll<HTMLElement>(".window-frame")];
      if (frames.length < 2) return;
      const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const interval = Number(this.dataset.interval);
      const events = new AbortController();
      let current = 0;
      let timer: number | undefined;
      let visible = false;
      let first = true;
      let busy = false;
      let alive = true;
      let revision = 0;
      let paused = motion.matches;
      const pauseButton = this.querySelector<HTMLButtonElement>("[data-image-pause]");
      const count = this.querySelector<HTMLElement>("[data-image-count]");
      const updatePause = () => {
        if (!pauseButton) return;
        pauseButton.textContent = paused ? "Play" : "Pause";
        pauseButton.setAttribute("aria-label", `${paused ? "Play" : "Pause"} photograph slideshow`);
      };
      updatePause();

      const load = async (index: number) => {
        const img = frames[index].querySelector<HTMLImageElement>("img")!;
        if (!img.hasAttribute("src")) {
          img.loading = "eager";
          img.srcset = img.dataset.srcset!;
          img.src = img.dataset.src!;
        }
        try { await img.decode(); return img.naturalWidth > 0; }
        catch { return false; }
      };
      const stop = () => { window.clearTimeout(timer); revision++; };
      const schedule = () => {
        stop();
        if (!alive || paused || !visible || document.hidden) return;
        void load((current + 1) % frames.length);
        timer = window.setTimeout(() => { void advance(); }, first ? Number(this.dataset.delay) : interval);
      };
      const advance = async (direction = 1, manual = false) => {
        if (busy) return;
        stop();
        const ticket = revision;
        busy = true;
        // A failed image never replaces a visible photograph with an empty frame.
        let target = (current + direction + frames.length) % frames.length;
        let ready = false;
        for (let attempts = 0; attempts < frames.length - 1; attempts++) {
          ready = await load(target);
          if (ready || ticket !== revision || !alive) break;
          target = (target + direction + frames.length) % frames.length;
        }
        busy = false;
        if (!alive || ticket !== revision) return;
        if (ready && (manual || (!paused && visible && !document.hidden))) {
          frames[current].classList.remove("is-current");
          frames[current].setAttribute("aria-hidden", "true");
          frames[target].classList.add("is-current");
          frames[target].setAttribute("aria-hidden", "false");
          current = target;
          first = false;
          if (count) count.textContent = `${current + 1} / ${frames.length}`;
        }
        schedule();
      };
      document.addEventListener("visibilitychange", schedule, { signal: events.signal });
      motion.addEventListener("change", () => { paused = motion.matches; updatePause(); schedule(); }, { signal: events.signal });
      this.querySelector("[data-image-back]")?.addEventListener("click", () => { void advance(-1, true); }, { signal: events.signal });
      this.querySelector("[data-image-next]")?.addEventListener("click", () => { void advance(1, true); }, { signal: events.signal });
      pauseButton?.addEventListener("click", () => { paused = !paused; updatePause(); schedule(); }, { signal: events.signal });
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting && entry.intersectionRatio >= 0.1;
        schedule();
      }, { threshold: 0.1 });
      observer.observe(this);
      this.cleanup = () => { alive = false; stop(); observer.disconnect(); events.abort(); };
    }
    private cleanup?: () => void;
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get("image-window")) customElements.define("image-window", ImageWindow);
</script>

<style>
  image-window { display: block; width: 100%; min-width: 0; overflow: hidden; border: 1px solid #bcb0a2; border-radius: 5px; background: #eee7df; box-shadow: 5px 6px 0 rgb(99 79 60 / 9%); }
  .window-viewport { position: relative; width: 100%; aspect-ratio: var(--window-ratio, 4 / 3); isolation: isolate; overflow: hidden; }
  .window-frame { position: absolute; inset: 0; opacity: 0; transition: opacity 850ms ease-in-out; pointer-events: none; }
  .window-frame.is-current { opacity: 1; }
  .window-frame img { display: block; width: 100%; height: 100%; max-width: none; }
  .window-controls { display: flex; align-items: center; justify-content: center; gap: 20px; height: 42px; font-size: 12px; background: #fcfaf5; }
  .window-controls button { min-width: 36px; height: 36px; border: 0; background: none; font: inherit; color: inherit; cursor: pointer; }
  .window-controls button:disabled { opacity: .3; cursor: default; }
  .window-controls button:last-child:not([data-image-next]) { margin-left: auto; }
  @media (prefers-reduced-motion: reduce) { .window-frame { transition: none; } }
</style>
