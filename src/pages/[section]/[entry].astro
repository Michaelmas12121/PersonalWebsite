---
import { getPortfolio, sectionUrl } from "../../v4/portfolio";
export async function getStaticPaths() {
  return (await getPortfolio()).map((entry) => ({
    params: { section: entry.section, entry: entry.id },
    props: { section: entry.section },
  }));
}
return Astro.redirect(sectionUrl(Astro.props.section), 301);
---
