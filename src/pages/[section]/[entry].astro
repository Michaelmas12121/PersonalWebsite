---
import "../../styles/global.css";
import "../../v4/portfolio.css";
import PortfolioNav from "../../v4/PortfolioNav.astro";
import ImageWindow from "../../v4/ImageWindow.astro";
import { getPortfolio, entryUrl } from "../../v4/portfolio";
export async function getStaticPaths() {
  const entries = await getPortfolio();
  return entries.map((entry) => ({ params: { section: entry.section, entry: entry.id }, props: { entry, entries } }));
}
const { entry, entries } = Astro.props;
const siblings = entries.filter((item) => item.section === entry.section);
const index = siblings.findIndex((item) => item.id === entry.id);
const previous = siblings[(index - 1 + siblings.length) % siblings.length];
const next = siblings[(index + 1) % siblings.length];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={entry.description[0]} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{entry.title} — Yanlang Liu</title>
  </head>
  <body>
    <main class="entry-page">
      <header>
        <a class="home-link" href="/" aria-label="Back to homepage">← <span>Home</span></a>
        <PortfolioNav entries={entries} active={entry.section} />
      </header>
      <div class="entry-layout">
        <aside>
          <p class="section-label">{entry.section}</p>
          <nav class="entry-list" aria-label={`Choose from ${entry.section}`}>
            {siblings.map((item, itemIndex) => <a href={entryUrl(item)} aria-current={item.id === entry.id ? "page" : undefined}><span>{String(itemIndex + 1).padStart(2, "0")}</span>{item.title}</a>)}
          </nav>
          <label class="mobile-chooser">Choose an entry
            <select aria-label={`Choose from ${entry.section}`}>
              {siblings.map((item) => <option value={entryUrl(item)} selected={item.id === entry.id}>{item.title}</option>)}
            </select>
          </label>
        </aside>
        <article class:list={["entry-content", { "has-media": entry.images.length > 0 }]} aria-labelledby="entry-title">
          <div class="entry-copy">
            <h1 id="entry-title">{entry.title}</h1>
            <div class="passages" aria-live="polite" aria-atomic="true">
              {entry.description.map((paragraph, paragraphIndex) => <p data-passage hidden={paragraphIndex > 0}>{paragraph}</p>)}
            </div>
            {entry.description.length > 1 && <div class="passage-controls" aria-label="Description pages"><button type="button" data-passage-back aria-label="Previous description page" disabled>←</button><span data-passage-count>1 / {entry.description.length}</span><button type="button" data-passage-next aria-label="Next description page">→</button></div>}
          </div>
          {entry.images.length > 0 && <div class="entry-media"><ImageWindow images={entry.images} label={entry.title} rhythm={index} sizes="(max-width: 700px) 90vw, 42vw" controls /></div>}
        </article>
      </div>
      <footer>
        <a href={entryUrl(previous)} aria-label={`Previous entry: ${previous.title}`}>← Previous</a>
        <span>{String(index + 1).padStart(2, "0")} / {String(siblings.length).padStart(2, "0")}</span>
        <a href={entryUrl(next)} aria-label={`Next entry: ${next.title}`}>Next →</a>
      </footer>
    </main>
    <script>
      const selector = document.querySelector<HTMLSelectElement>("select");
      selector?.addEventListener("change", () => { window.location.href = selector.value; });
      const passages = [...document.querySelectorAll<HTMLElement>("[data-passage]")];
      const back = document.querySelector<HTMLButtonElement>("[data-passage-back]");
      const next = document.querySelector<HTMLButtonElement>("[data-passage-next]");
      const count = document.querySelector<HTMLElement>("[data-passage-count]");
      let current = 0;
      function showPassage(index: number) {
        current = Math.max(0, Math.min(passages.length - 1, index));
        passages.forEach((passage, i) => { passage.hidden = i !== current; });
        if (back && next && count) {
          back.disabled = current === 0;
          next.disabled = current === passages.length - 1;
          count.textContent = `${current + 1} / ${passages.length}`;
        }
      }
      back?.addEventListener("click", () => showPassage(current - 1));
      next?.addEventListener("click", () => showPassage(current + 1));
    </script>
  </body>
</html>
<style>
  :global(html), :global(body) { overflow: hidden; }
  .entry-page { height: 100svh; padding: clamp(16px, 3vw, 48px); display: grid; grid-template-rows: auto minmax(0, 1fr) auto; gap: clamp(18px, 3vh, 32px); }
  header { display: flex; align-items: center; justify-content: space-between; font-size: clamp(11px, 1vw, 15px); }
  .home-link { display: flex; gap: 10px; align-items: center; }
  .entry-layout { display: grid; grid-template-columns: minmax(175px, 20%) minmax(0, 1fr); gap: 4vw; min-height: 0; }
  aside { border-right: 1px solid #ddd7cb; padding-right: 2vw; }
  .section-label { text-transform: uppercase; font-family: "Anton", Impact, sans-serif; font-size: 34px; margin: 18px 0 26px; }
  .entry-list { display: flex; flex-direction: column; gap: clamp(12px, 2.5vh, 28px); }
  .entry-list a { display: flex; align-items: baseline; gap: 12px; font-size: clamp(12px, 1.05vw, 16px); line-height: 1.4; color: #767168; }
  .entry-list a span { font-size: 10px; }
  .entry-list a[aria-current] { color: #242420; font-weight: 700; }
  .entry-list a:hover { color: #8a6450; }
  .entry-content { display: grid; align-content: center; min-height: 0; gap: 3vw; }
  .entry-content.has-media { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: center; }
  .entry-copy { min-width: 0; }
  h1 { font: 400 clamp(32px, 4vw, 72px)/1.06 "Anton", Impact, sans-serif; letter-spacing: -.015em; margin: 0 0 28px; max-width: 18ch; text-wrap: balance; }
  .passages { max-width: 65ch; }
  .passages p { font-size: clamp(15px, 1.25vw, 20px); line-height: 1.65; margin: 0; text-wrap: pretty; }
  .passage-controls { display: flex; align-items: center; gap: 20px; margin-top: 20px; font-size: 12px; }
  .passage-controls button { border: 1px solid #d5cec0; border-radius: 50%; width: 36px; height: 36px; background: none; }
  .passage-controls button:disabled { opacity: .3; cursor: default; }
  .entry-media { height: min(58svh, 620px); min-height: 0; }
  .entry-media :global(image-window) { height: 100%; border: 0; border-radius: 0; box-shadow: none; background: #eeeae0; }
  .entry-media :global(.window-viewport) { height: calc(100% - 42px); aspect-ratio: auto; }
  footer { display: flex; justify-content: space-between; align-items: center; font-size: 13px; border-top: 1px solid #ddd7cb; padding-top: 18px; }
  footer span { color: #767168; font-size: 12px; }
  .mobile-chooser { display: none; }
  @media (max-width: 1050px) {
    .entry-layout { grid-template-columns: minmax(150px, 20%) minmax(0, 1fr); gap: 3vw; }
    .entry-content.has-media { grid-template-columns: 1fr; gap: 18px; }
    .entry-media { height: min(32svh, 350px); grid-row: 1; }
    h1 { font-size: clamp(26px, 3.3vw, 46px); margin-bottom: 18px; max-width: 30ch; }
    .passages p { font-size: 15px; line-height: 1.5; }
  }
  @media (max-width: 700px) {
    .entry-page { padding: 18px; gap: 18px; }
    header { gap: 12px; }
    .home-link span { display: none; }
    .entry-layout { display: flex; flex-direction: column; gap: 18px; }
    aside { border: 0; padding: 0; }
    .section-label, .entry-list { display: none; }
    .mobile-chooser { display: block; font-size: 0; }
    select { width: 100%; background: transparent; border: 0; border-bottom: 1px solid #d5cec0; border-radius: 0; font-size: 14px; padding: 8px 0 12px; }
    .entry-content { flex: 1; gap: 16px; }
    .entry-content.has-media { display: flex; flex-direction: column; align-items: stretch; justify-content: center; }
    .entry-media { order: -1; height: 27svh; flex-shrink: 0; }
    h1 { font-size: clamp(25px, 6.5vw, 36px); margin-bottom: 14px; }
    .passages p { font-size: 15px; line-height: 1.5; }
    .passage-controls { margin-top: 14px; }
    footer { padding-top: 14px; }
  }
  @media (max-height: 700px) {
    .entry-page { gap: 12px; padding-top: 12px; padding-bottom: 12px; }
    .section-label { margin: 10px 0 18px; }
    h1 { font-size: clamp(24px, 3vw, 44px); margin-bottom: 12px; }
    .passages p { font-size: 14px; line-height: 1.45; }
    .passage-controls { margin-top: 10px; }
  }
  @media (max-height: 500px) and (orientation: landscape) {
    .entry-layout { grid-template-columns: 150px minmax(0, 1fr); gap: 20px; }
    .entry-content.has-media { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .entry-media { grid-row: auto; height: 60svh; }
    .entry-list { gap: 8px; }
    .section-label { font-size: 22px; margin: 0 0 12px; }
    h1 { font-size: 24px; }
    .passages p { font-size: 12px; }
    footer { padding-top: 8px; }
  }
</style>
