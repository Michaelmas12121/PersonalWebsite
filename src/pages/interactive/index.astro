---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import aimeCertificate from "../../assets/certificates/v4/aime-2026.webp";
import himcmCertificate from "../../assets/certificates/v4/himcm-2025-redacted.webp";
import immcFinalistCertificate from "../../assets/certificates/v4/immc-finalist-2026-redacted.webp";
import immcOutstandingCertificate from "../../assets/certificates/v4/immc-outstanding-2026-redacted.webp";
import metabolisCover from "../../assets/continue/metabolis/background-title-source.png";
import metabolisTitleScreen from "../../assets/continue/metabolis/title-screen.png";
import metabolisTitleVideo from "../../assets/continue/metabolis/video/title-opening.mp4";
import metabolisCirculationVideo from "../../assets/continue/metabolis/video/circulation-system.mp4";
import metabolisNetworkVideo from "../../assets/continue/metabolis/video/network-building.mp4";
import metabolisOverviewVideo from "../../assets/continue/metabolis/video/system-overview.mp4";

/**
 * Version 4 visual foundation. The generated room studies are references only;
 * the room itself is code-native geometry so its camera and colour can change.
 */
interface Entry {
  view: "figure" | "monitor" | "mac" | "achievements" | "window";
  label: string;
  note: string;
  object: string;
  body: string;
  colours: [string, string, string];
}

// The four certificates on the shelf. These are the privacy-safe copies made for
// the site: only Yanlang Liu's name survives, every other name is pixelated, and
// the source PDFs stay outside the repository.
const certificates = [
  {
    image: immcOutstandingCertificate,
    context: "IMMC 2026 · Greater China",
    title: "Outstanding",
    note: "The top award at the 12th International Mathematical Modeling Challenge. Team of four.",
  },
  {
    image: immcFinalistCertificate,
    context: "IMMC 2026 · Greater China",
    title: "Finalist",
    note: "The nomination round of the same challenge, before the international judging. Team of four.",
  },
  {
    image: himcmCertificate,
    context: "HiMCM 2025",
    title: "Meritorious",
    note: "The High School Mathematical Contest in Modeling, run by COMAP. Team of four.",
  },
  {
    image: aimeCertificate,
    context: "AIME II 2026",
    title: "Participation",
    note: "The American Invitational Mathematics Examination, reached through the AMC. Sat alone.",
  },
];

// Gallery photographs are deliberately uncaptioned, and ordered by the original
// import sequence rather than by anything the visitor is meant to read into it.
const photos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../../assets/gallery/*.webp", { eager: true }),
)
  .sort(([left], [right]) => left.localeCompare(right))
  .map(([, module]) => module.default);

const cyclingRouteImages = Object.fromEntries(
  Object.entries(
    import.meta.glob<{ default: ImageMetadata }>(
      "../../assets/continue/cycling/rides/*.webp",
      { eager: true },
    ),
  ).map(([path, module]) => [path.split("/").at(-1)?.replace(".webp", ""), module.default]),
) as Record<string, ImageMetadata>;

const cyclingRides = [
  { id: "ride-01", distance: "13.8", average: "19.4", duration: "42:38" },
  { id: "ride-02", distance: "21.3", average: "15.2", duration: "01:24:00" },
  { id: "ride-03", distance: "23.1", average: "19.2", duration: "01:12:06" },
  { id: "ride-04", distance: "8.4", average: "14.4", duration: "35:05" },
  { id: "ride-05", distance: "20.3", average: "18.7", duration: "01:04:56" },
  { id: "ride-06", distance: "20.3", average: "20.9", duration: "58:17" },
  { id: "ride-07", distance: "22.5", average: "22.0", duration: "01:01:24" },
  { id: "ride-08", distance: "20.1", average: "20.5", duration: "58:51" },
  { id: "ride-09", distance: "20.3", average: "20.4", duration: "59:30" },
  { id: "ride-10", distance: "20.7", average: "22.6", duration: "54:57" },
  { id: "ride-11", distance: "21.2", average: "22.6", duration: "56:20" },
  { id: "ride-12", distance: "19.0", average: "18.5", duration: "01:02:00" },
  { id: "ride-13", distance: "20.1", average: "22.2", duration: "54:13" },
  { id: "ride-14", distance: "20.0", average: "22.8", duration: "52:39" },
  { id: "ride-15", distance: "18.7", average: "21.6", duration: "51:51" },
  { id: "ride-16", distance: "17.9", average: "20.4", duration: "52:48" },
  { id: "ride-17", distance: "19.6", average: "14.4", duration: "01:21:27" },
].map((ride, index) => ({
  ...ride,
  image: cyclingRouteImages[ride.id],
  label: `Ride ${String(index + 1).padStart(2, "0")}`,
}));

const activities = (await getCollection("activities")).sort(
  (left, right) => left.data.order - right.data.order,
);
const renderedActivities = await Promise.all(
  activities.map(async (activity) => ({
    activity,
    Content: (await render(activity)).Content,
  })),
);

const entries: Entry[] = [
  {
    view: "figure",
    label: "Who am I",
    note: "The figure",
    object: "A low-poly avatar seated at the desk",
    body: "I am Yanlang Liu, seventeen, from Shenzhen. I study in the international division at Shenzhen Middle School. This is placeholder writing — the full first-person account, and how to reach me, still has to be written.",
    colours: ["#687b86", "#b97865", "#d5c5ac"],
  },
  {
    view: "monitor",
    label: "Continue",
    note: "The desk display",
    object: "The single display on the desk",
    body: "A game still being built and a visual log of rides still being ridden.",
    colours: ["#2f6970", "#86a0a0", "#d5a84a"],
  },
  {
    view: "mac",
    label: "What I've done",
    note: "The Mac on the bed",
    object: "The open computer near the head of the bed",
    body: "Choose a project or activity. Conrad is one part of the record, not the whole of it.",
    colours: ["#3f526b", "#a46b58", "#c9a45b"],
  },
  {
    view: "achievements",
    label: "Achievements",
    note: "The display shelf",
    object: "The divided shelf near the doorway",
    body: "Competition results, as the certificates themselves.",
    colours: ["#705845", "#b39861", "#754f57"],
  },
  {
    view: "window",
    label: "Gallery",
    note: "The window",
    object: "The window and deep sill",
    body: "Photographs, uncaptioned.",
    colours: ["#7393a1", "#7e956f", "#d7b66a"],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Yanlang Liu — interactive room study."
    />
    <title>Yanlang Liu — Interactive Room</title>
  </head>

  <body data-mode="flat" data-active="">
    <div class="poster" aria-hidden="true">
      <div class="poster-room"></div>
      <div class="poster-window"><i></i><b></b></div>
      <div class="poster-sill"></div>
      <div class="poster-desk"></div>
      <div class="poster-desk-cabinet"></div>
      <div class="poster-monitor"></div>
      <div class="poster-achievements"><i></i><b></b></div>
      <div class="poster-chair"></div>
      <div class="poster-figure"><i></i><b></b><span></span></div>
      <div class="poster-bed"></div>
      <div class="poster-bed-cabinet"></div>
      <div class="poster-mac"></div>
    </div>

    <canvas id="stage" hidden></canvas>
    <div class="scrim" id="scrim" aria-hidden="true"></div>

    <header class="ui top">
      <p class="name">Yanlang Liu</p>
      <p class="version">Interactive room</p>
      <p class="hint" id="hint">Choose an object. Colour travels through the room as you enter.</p>
    </header>

    <nav class="ui menu" id="menu" aria-label="Main menu">
      {
        entries.map((entry) => (
          <button type="button" data-view={entry.view}>
            <span class="mark" aria-hidden="true"></span>
            <span class="label">{entry.label}</span>
            <span class="note">{entry.note}</span>
          </button>
        ))
      }
    </nav>

    <button type="button" class="ui back" id="back" hidden>← Back to the room</button>

    <section class="ui panel" id="panel" hidden aria-live="polite">
      <div id="standard-panel" class="standard-content">
        <p class="panel-state">Visual prototype</p>
        <h2 id="panel-title"></h2>
        <p class="panel-object" id="panel-object"></p>
        <p class="panel-body" id="panel-body"></p>
        <div class="swatches" id="swatches" aria-label="Active colour palette"></div>
      </div>

      <div id="continue-panel" hidden>
        <div class="continue-content" data-continue-app="desktop">
          <header class="continue-menu-bar">
            <div>
              <strong>Continue</strong>
              <span>Active work · personal computer</span>
            </div>
            <div class="computer-status" aria-hidden="true">
              <span class="status-signal"></span>
              <span>Local</span>
              <time>10:42</time>
            </div>
          </header>

          <main class="continue-desktop" aria-label="Continue personal computer">
            <div class="desktop-welcome" data-continue-screen="desktop">
              <p>My active workspace</p>
              <h2>Continue</h2>
              <span>Open an application or folder to see what I am building now.</span>
            </div>

            <button class="desktop-shortcut games-shortcut" type="button" data-continue-open="games">
              <span class="folder-icon" aria-hidden="true"></span>
              <span>Games</span>
            </button>

            <button class="desktop-shortcut cycling-shortcut" type="button" data-continue-open="cycling">
              <span class="route-app-icon" aria-hidden="true"><i></i></span>
              <span>Cycling</span>
            </button>

            <section class="continue-os-window games-window" data-continue-screen="games" hidden aria-label="Games folder">
              <header class="os-title-bar">
                <button class="window-back" type="button" data-continue-open="desktop">← Desktop</button>
                <div><span class="folder-icon" aria-hidden="true"></span><strong>Games</strong></div>
                <span class="window-actions" aria-hidden="true"><i></i><i></i><i></i></span>
              </header>

              <div class="game-library">
                <button class="game-tile metabolis-tile" type="button" data-continue-open="metabolis">
                  <span class="game-cover">
                    <Image
                      src={metabolisCover}
                      alt="Metabolis pixel-art road with biological transport vehicles"
                      widths={[320, 480, 640]}
                      sizes="(max-width: 899px) 72vw, 280px"
                    />
                  </span>
                  <strong>Metabolis</strong>
                  <span class="active-game"><i></i>Active</span>
                </button>

                {Array.from({ length: 3 }).map(() => (
                  <button class="game-tile future-game" type="button" disabled>
                    <span class="future-game-icon" aria-hidden="true"><i></i><b></b></span>
                    <strong>Coming soon</strong>
                    <span>Link not added</span>
                  </button>
                ))}
              </div>
            </section>

            <section class="continue-os-window metabolis-window" data-continue-screen="metabolis" hidden aria-label="Metabolis opening">
              <header class="os-title-bar">
                <button class="window-back" type="button" data-continue-open="games">← Games</button>
                <strong>Metabolis</strong>
                <button class="window-replay" type="button" data-metabolis-replay>Replay slide</button>
              </header>
              <div class="metabolis-deck" id="metabolis-opening">
                <div class="metabolis-slides">
                  <article class="metabolis-slide title-slide" data-metabolis-panel="0">
                    <video
                      src={metabolisTitleVideo}
                      poster={metabolisTitleScreen.src}
                      muted
                      playsinline
                      preload="metadata"
                      aria-label="Metabolis title animation"
                    ></video>
                    <div class="slide-shade" aria-hidden="true"></div>
                    <div class="slide-copy">
                      <p>01 · Opening</p>
                      <h3>Metabolis</h3>
                      <span>Birth of the City of Life · Godot 4 · GDScript</span>
                    </div>
                  </article>
                  <article class="metabolis-slide" data-metabolis-panel="1">
                    <video src={metabolisCirculationVideo} muted playsinline preload="metadata"></video>
                    <div class="slide-copy">
                      <p>02 · Circulation</p>
                      <h3>Build the network</h3>
                      <span>Place facilities, connect routes and move biological resources through the city.</span>
                    </div>
                  </article>
                  <article class="metabolis-slide" data-metabolis-panel="2">
                    <video src={metabolisNetworkVideo} muted playsinline preload="metadata"></video>
                    <div class="slide-copy">
                      <p>03 · Network building</p>
                      <h3>Link each system</h3>
                      <span>Construction choices turn organs, vehicles and roads into an operating network.</span>
                    </div>
                  </article>
                  <article class="metabolis-slide" data-metabolis-panel="3">
                    <video src={metabolisOverviewVideo} muted playsinline preload="metadata"></video>
                    <div class="slide-copy">
                      <p>04 · System overview</p>
                      <h3>Watch the city live</h3>
                      <span>Multiple biological systems share one evolving pixel-art city.</span>
                    </div>
                  </article>
                </div>
                <button class="slide-arrow previous" type="button" data-metabolis-previous aria-label="Previous slide">←</button>
                <button class="slide-arrow next" type="button" data-metabolis-next aria-label="Next slide">→</button>
                <nav class="slide-dots" aria-label="Metabolis slides">
                  {["Opening", "Circulation", "Network", "Overview"].map((label, index) => (
                    <button
                      type="button"
                      class:list={{ active: index === 0 }}
                      data-metabolis-slide={index}
                      aria-label={`Open ${label} slide`}
                      aria-pressed={index === 0 ? "true" : "false"}
                    ><span>{String(index + 1).padStart(2, "0")}</span>{label}</button>
                  ))}
                </nav>
              </div>
            </section>

            <section class="continue-os-window cycling-window" data-continue-screen="cycling" hidden aria-label="Cycling app">
              <header class="os-title-bar">
                <button class="window-back" type="button" data-continue-open="desktop">← Desktop</button>
                <strong>Cycling · routes through Shenzhen</strong>
                <span class="ride-count">17 rides · 327.3 km</span>
              </header>
              <div class="cycling-app-layout">
                <aside class="ride-list">
                  <div class="ride-list-heading">
                    <div>
                      <p>Route archive</p>
                      <strong>17 rides</strong>
                    </div>
                    <span>327.3 km</span>
                  </div>
                  <div class="ride-list-scroll">
                    {cyclingRides.map((ride, index) => (
                      <button
                        type="button"
                        class:list={["ride-entry", { active: index === 0 }]}
                        data-cycling-ride={ride.id}
                        aria-pressed={index === 0 ? "true" : "false"}
                      >
                        <span>{ride.label}</span>
                        <strong>{ride.distance} km</strong>
                        <small>{ride.average} km/h · {ride.duration}</small>
                      </button>
                    ))}
                  </div>
                </aside>
                <div class="cycling-route-stage">
                  {cyclingRides.map((ride, index) => (
                    <article
                      class="cycling-map"
                      data-cycling-route={ride.id}
                      hidden={index !== 0}
                    >
                      <div class="route-image">
                        <Image
                          src={ride.image}
                          alt={`Privacy-cropped route from ${ride.label.toLowerCase()} through Shenzhen`}
                          widths={[760, 1100]}
                          sizes="(max-width: 899px) 100vw, 72vw"
                          loading={index === 0 ? "eager" : "lazy"}
                        />
                        <div class="route-label">
                          <span>{ride.label}</span>
                          <strong>Shenzhen footprint</strong>
                        </div>
                      </div>
                      <footer class="route-details">
                        <dl class="ride-stats">
                          <div><dt>Distance</dt><dd>{ride.distance} <span>km</span></dd></div>
                          <div><dt>Average</dt><dd>{ride.average} <span>km/h</span></dd></div>
                          <div><dt>Duration</dt><dd>{ride.duration}</dd></div>
                        </dl>
                        <p class="route-privacy">Original dates, account identity and exact endpoints are omitted.</p>
                      </footer>
                    </article>
                  ))}
                  <nav class="mobile-ride-nav" aria-label="Choose a cycling route">
                    {cyclingRides.map((ride, index) => (
                      <button
                        type="button"
                        class:list={{ active: index === 0 }}
                        data-cycling-ride={ride.id}
                        aria-label={`Open ${ride.label}`}
                        aria-pressed={index === 0 ? "true" : "false"}
                      >{String(index + 1).padStart(2, "0")}</button>
                    ))}
                  </nav>
                </div>
              </div>
            </section>

            <nav class="computer-dock" aria-label="Continue applications">
              <button type="button" data-continue-open="games">
                <span class="folder-icon" aria-hidden="true"></span>
                <span>Games</span>
              </button>
              <i aria-hidden="true"></i>
              <button type="button" data-continue-open="cycling">
                <span class="route-app-icon" aria-hidden="true"><b></b></span>
                <span>Cycling</span>
              </button>
            </nav>
          </main>
        </div>
      </div>

      <div id="projects-panel" hidden>
        <div class="mac-app-bar" aria-hidden="true">
          <span class="mac-window-controls"><i></i><i></i><i></i></span>
          <span>What I've done</span>
          <span>Projects and activities</span>
        </div>

        <div class="app-content">
          <header class="projects-heading">
            <div>
              <p class="panel-state">The Mac on the bed</p>
              <h2>What I've done</h2>
            </div>
            <p>Choose one project or activity to open its full account.</p>
          </header>

          <div class="project-grid" id="project-grid">
            {
              renderedActivities.map(({ activity }, index) => (
                <button
                  class="project-card"
                  type="button"
                  data-project={activity.id}
                  aria-controls={`project-${activity.id}`}
                  style={`--reveal-index: ${index}`}
                >
                  <span class="project-cover">
                    {activity.data.cover ? (
                      <Image
                        src={activity.data.cover}
                        alt={activity.data.coverAlt ?? ""}
                        widths={[360, 540]}
                        sizes="(max-width: 899px) 82vw, 360px"
                      />
                    ) : (
                      <span class="project-lines" aria-hidden="true"><i></i><b></b></span>
                    )}
                  </span>
                  <span class="project-context">{activity.data.context}</span>
                  <strong>{activity.data.title}</strong>
                  <span class="project-summary">{activity.data.summary}</span>
                  <span class="project-open">Open →</span>
                </button>
              ))
            }
          </div>

          <div class="project-reader" id="project-reader" hidden>
            {
              renderedActivities.map(({ activity, Content }) => (
                <article id={`project-${activity.id}`} data-project-detail={activity.id} hidden>
                  <p class="project-context">{activity.data.context}</p>
                  <h2 tabindex="-1">{activity.data.title}</h2>
                  {activity.data.role && <p class="project-role">{activity.data.role}</p>}
                  <div class="project-content"><Content /></div>
                </article>
              ))
            }
          </div>
        </div>
      </div>

      <div id="certificates-panel" hidden>
        <div class="app-content">
          <header class="projects-heading">
            <div>
              <p class="panel-state">The display shelf</p>
              <h2>Achievements</h2>
            </div>
            <p>
              Mathematical modelling, in teams of four, and one examination sat
              alone. Open a certificate to read it full size.
            </p>
          </header>

          <div class="certificate-grid">
            {
              certificates.map((certificate) => (
                <a
                  class="certificate-card"
                  href={certificate.image.src}
                  target="_blank"
                  rel="noopener">
                  <span class="certificate-sheet">
                    <Image
                      src={certificate.image}
                      alt={`${certificate.context} — ${certificate.title} certificate`}
                      widths={[380, 720]}
                      sizes="(max-width: 899px) 88vw, 420px"
                      loading="lazy"
                    />
                  </span>
                  <span class="project-context">{certificate.context}</span>
                  <strong>{certificate.title}</strong>
                  <span class="certificate-note">{certificate.note}</span>
                  <span class="project-open">Open the certificate →</span>
                </a>
              ))
            }
          </div>

          <p class="certificate-footnote">
            Names other than mine are pixelated on every copy shown here.
          </p>
        </div>
      </div>

      <div id="gallery-panel" hidden>
        <div class="app-content">
          <header class="projects-heading">
            <div>
              <p class="panel-state">The window</p>
              <h2>Gallery</h2>
            </div>
            <p>{photos.length} frames, uncaptioned. Open one to see it full size.</p>
          </header>

          <div class="gallery-columns">
            {
              photos.map((photo, index) => (
                <a
                  class="gallery-photo"
                  href={photo.src}
                  target="_blank"
                  rel="noopener"
                  style={`--reveal-index: ${index % 9}`}
                  aria-label={`Open photograph ${index + 1}`}>
                  <Image
                    src={photo}
                    alt=""
                    widths={[360, 640, 1000]}
                    sizes="(max-width: 899px) 88vw, 24vw"
                    loading="lazy"
                  />
                </a>
              ))
            }
          </div>
        </div>

        <div
          class="gallery-lightbox"
          id="gallery-lightbox"
          role="dialog"
          aria-modal="true"
          aria-label="Photograph preview"
          hidden>
          <button type="button" id="gallery-lightbox-close" aria-label="Close photograph">Close</button>
          <figure id="gallery-lightbox-frame">
            <img id="gallery-lightbox-image" alt="" />
          </figure>
        </div>
      </div>
    </section>

    <p class="ui hover" id="hover" aria-hidden="true"></p>

    <script>
      import { canRenderRoom } from "../../v4/room/enhance";

      type ViewName = "figure" | "monitor" | "mac" | "achievements" | "window";
      type Entry = {
        view: ViewName;
        label: string;
        note: string;
        object: string;
        body: string;
        colours: [string, string, string];
      };
      type PortalFrame = { top: number; right: number; bottom: number; left: number };
      type NativeViewTransition = { finished: Promise<void> };
      type TransitionDocument = Document & {
        startViewTransition?: (update: () => void | Promise<void>) => NativeViewTransition;
      };

      const entries: Entry[] = JSON.parse(
        document.getElementById("entry-data")!.textContent!,
      );
      const byView = new Map(entries.map((entry) => [entry.view, entry]));

      const body = document.body;
      const canvas = document.getElementById("stage") as HTMLCanvasElement;
      const menu = document.getElementById("menu")!;
      const panel = document.getElementById("panel")!;
      const standardPanel = document.getElementById("standard-panel")!;
      const continuePanel = document.getElementById("continue-panel")!;
      const projectsPanel = document.getElementById("projects-panel")!;
      const certificatesPanel = document.getElementById("certificates-panel")!;
      const galleryPanel = document.getElementById("gallery-panel")!;
      const galleryLightbox = document.getElementById("gallery-lightbox")!;
      const galleryLightboxFrame = document.getElementById("gallery-lightbox-frame")!;
      const galleryLightboxImage = document.getElementById("gallery-lightbox-image") as HTMLImageElement;
      const galleryLightboxClose = document.getElementById("gallery-lightbox-close")!;
      const projectGrid = document.getElementById("project-grid")!;
      const projectReader = document.getElementById("project-reader")!;
      const continueContent = document.querySelector<HTMLElement>(".continue-content")!;
      const continueScreens = Array.from(
        document.querySelectorAll<HTMLElement>("[data-continue-screen]"),
      );
      const metabolisOpening = document.getElementById("metabolis-opening")!;
      const metabolisSlides = Array.from(
        metabolisOpening.querySelectorAll<HTMLElement>("[data-metabolis-panel]"),
      );
      const metabolisSlideButtons = Array.from(
        metabolisOpening.querySelectorAll<HTMLButtonElement>("[data-metabolis-slide]"),
      );
      const metabolisVideos = Array.from(
        metabolisOpening.querySelectorAll<HTMLVideoElement>(".metabolis-slide video"),
      );
      let activeMetabolisSlide = 0;
      const cyclingRideButtons = Array.from(
        continueContent.querySelectorAll<HTMLButtonElement>("[data-cycling-ride]"),
      );
      const cyclingRoutes = Array.from(
        continueContent.querySelectorAll<HTMLElement>("[data-cycling-route]"),
      );
      const projectDetails = Array.from(
        document.querySelectorAll<HTMLElement>("[data-project-detail]"),
      );
      const panelTitle = document.getElementById("panel-title")!;
      const panelObject = document.getElementById("panel-object")!;
      const panelBody = document.getElementById("panel-body")!;
      const swatches = document.getElementById("swatches")!;
      const scrim = document.getElementById("scrim")!;
      const back = document.getElementById("back")!;
      const hover = document.getElementById("hover")!;
      const hint = document.getElementById("hint")!;
      let activeProject: HTMLElement | null = null;
      let activeGalleryPhoto: HTMLAnchorElement | null = null;

      function beginViewTransition(update: () => void) {
        const start = (document as TransitionDocument).startViewTransition;
        if (!start) {
          update();
          return null;
        }
        return start.call(document, update);
      }

      function setTransitionName(element: HTMLElement | null, name: string) {
        if (element) element.style.viewTransitionName = name;
      }

      function clearTransitionNames(...elements: Array<HTMLElement | null>) {
        elements.forEach((element) => {
          if (element) element.style.viewTransitionName = "";
        });
      }

      function animateFallbackFrame(
        from: HTMLElement,
        update: () => void,
        resolveTarget: () => HTMLElement | null,
        onFinish?: () => void,
      ) {
        const fromRect = from.getBoundingClientRect();
        const clone = from.cloneNode(true) as HTMLElement;
        clone.querySelectorAll("[id]").forEach((element) => element.removeAttribute("id"));
        clone.removeAttribute("id");
        clone.setAttribute("aria-hidden", "true");
        clone.classList.add("shared-transition-clone");
        Object.assign(clone.style, {
          top: `${fromRect.top}px`,
          left: `${fromRect.left}px`,
          width: `${fromRect.width}px`,
          height: `${Math.min(fromRect.height, window.innerHeight - fromRect.top)}px`,
        });
        document.body.append(clone);
        update();
        const target = resolveTarget();
        if (!target) {
          clone.remove();
          onFinish?.();
          return;
        }
        const targetRect = target.getBoundingClientRect();
        target.style.opacity = "0";
        const animation = clone.animate(
          [
            {
              top: `${fromRect.top}px`,
              left: `${fromRect.left}px`,
              width: `${fromRect.width}px`,
              height: `${Math.min(fromRect.height, window.innerHeight - fromRect.top)}px`,
              opacity: 1,
            },
            {
              top: `${targetRect.top}px`,
              left: `${targetRect.left}px`,
              width: `${targetRect.width}px`,
              height: `${Math.min(targetRect.height, window.innerHeight - targetRect.top)}px`,
              opacity: 0.18,
            },
          ],
          {
            duration: 580,
            easing: "cubic-bezier(0.22, 0.72, 0.18, 1)",
            fill: "forwards",
          },
        );
        animation.finished.catch(() => undefined).finally(() => {
          clone.remove();
          target.style.opacity = "";
          target.animate(
            [{ opacity: 0, transform: "translateY(8px)" }, { opacity: 1, transform: "none" }],
            { duration: 180, easing: "ease-out" },
          );
          onFinish?.();
        });
      }

      function projectCard(projectId: string) {
        return Array.from(projectGrid.querySelectorAll<HTMLElement>("[data-project]")).find(
          (candidate) => candidate.dataset.project === projectId,
        ) ?? null;
      }

      function resetProjectGrid() {
        activeProject = null;
        projectGrid.hidden = false;
        projectReader.hidden = true;
        projectDetails.forEach((detail) => { detail.hidden = true; });
        back.textContent = "← Back to the room";
        panel.scrollTo({ top: 0, behavior: "auto" });
      }

      function showProjectGrid(animated = false) {
        if (!animated || !activeProject) {
          resetProjectGrid();
          return;
        }
        const detail = activeProject;
        const projectId = detail.dataset.projectDetail ?? "";
        const card = projectCard(projectId);
        const detailHero = detail.querySelector<HTMLElement>(".project-hero");
        const detailTitle = detail.querySelector<HTMLElement>(":scope > h2");
        const update = () => {
          resetProjectGrid();
        };
        if (!(document as TransitionDocument).startViewTransition && card) {
          animateFallbackFrame(detail, update, () => card);
          return;
        }
        setTransitionName(detail, "project-frame");
        setTransitionName(detailHero, "project-media");
        setTransitionName(detailTitle, "project-title");
        const transition = beginViewTransition(() => {
          clearTransitionNames(detail, detailHero, detailTitle);
          update();
          setTransitionName(card, "project-frame");
          setTransitionName(card?.querySelector<HTMLElement>(".project-cover") ?? null, "project-media");
          setTransitionName(card?.querySelector<HTMLElement>("strong") ?? null, "project-title");
        });
        const clear = () => clearTransitionNames(
          card,
          card?.querySelector<HTMLElement>(".project-cover") ?? null,
          card?.querySelector<HTMLElement>("strong") ?? null,
        );
        transition?.finished.finally(clear);
        if (!transition) requestAnimationFrame(clear);
      }

      function prepareProjectGalleries(detail: HTMLElement) {
        if (detail.dataset.galleriesReady === "true") return;
        const content = detail.querySelector<HTMLElement>(".project-content");
        const leadingImageParagraph = content?.firstElementChild as HTMLElement | null;
        if (leadingImageParagraph?.matches("p") && leadingImageParagraph.querySelector(":scope > img")) {
          const captionParagraph = leadingImageParagraph.nextElementSibling as HTMLElement | null;
          const image = leadingImageParagraph.querySelector("img");
          if (image) {
            const hero = document.createElement("figure");
            hero.className = "project-hero";
            hero.append(image);
            if (captionParagraph?.matches("p") && captionParagraph.querySelector(":scope > em")) {
              const caption = document.createElement("figcaption");
              caption.textContent = captionParagraph.textContent?.trim() ?? "";
              hero.append(caption);
              captionParagraph.remove();
            }
            detail.querySelector(":scope > h2")?.after(hero);
            leadingImageParagraph.remove();
          }
        }
        const sectionClasses = new Map([
          ["robot testing", "testing"],
          ["the team prototype", "prototype"],
          ["the result", "result"],
          ["inside one lesson", "lesson"],
          ["the team around the position", "football"],
        ]);

        detail.querySelectorAll<HTMLElement>(".project-content h2").forEach((heading) => {
          const galleryClass = sectionClasses.get(heading.textContent?.trim().toLowerCase() ?? "");
          if (!galleryClass) return;

          const items: Array<{
            imageParagraph: HTMLElement;
            captionParagraph: HTMLElement | null;
          }> = [];
          let candidate = heading.nextElementSibling as HTMLElement | null;
          while (candidate && candidate.tagName !== "H2") {
            const next = candidate.nextElementSibling as HTMLElement | null;
            if (candidate.matches("p") && candidate.querySelector(":scope > img")) {
              const captionParagraph = next?.matches("p") && next.querySelector(":scope > em")
                ? next
                : null;
              items.push({ imageParagraph: candidate, captionParagraph });
              candidate = captionParagraph
                ? captionParagraph.nextElementSibling as HTMLElement | null
                : next;
            } else {
              candidate = next;
            }
          }

          if (!items.length) return;
          const gallery = document.createElement("div");
          gallery.className = `media-gallery ${galleryClass}`;
          items[0].imageParagraph.before(gallery);
          items.forEach(({ imageParagraph, captionParagraph }) => {
            const image = imageParagraph.querySelector("img");
            if (!image) return;
            const figure = document.createElement("figure");
            figure.append(image);
            if (captionParagraph) {
              const caption = document.createElement("figcaption");
              caption.textContent = captionParagraph.textContent?.trim() ?? "";
              figure.append(caption);
              captionParagraph.remove();
            }
            gallery.append(figure);
            imageParagraph.remove();
          });
        });
        detail.dataset.galleriesReady = "true";
      }

      function showProject(projectId: string) {
        const detail = projectDetails.find(
          (candidate) => candidate.dataset.projectDetail === projectId,
        );
        if (!detail) return;
        prepareProjectGalleries(detail);
        const card = projectCard(projectId);
        const cardCover = card?.querySelector<HTMLElement>(".project-cover") ?? null;
        const cardTitle = card?.querySelector<HTMLElement>("strong") ?? null;
        const update = () => {
          projectDetails.forEach((candidate) => { candidate.hidden = candidate !== detail; });
          activeProject = detail;
          projectGrid.hidden = true;
          projectReader.hidden = false;
          back.textContent = "← All projects";
          panel.scrollTo({ top: 0, behavior: "auto" });
        };
        const focusTitle = () => detail.querySelector<HTMLElement>("h2")?.focus({ preventScroll: true });
        if (!(document as TransitionDocument).startViewTransition && card) {
          animateFallbackFrame(card, update, () => detail, focusTitle);
          return;
        }
        setTransitionName(card, "project-frame");
        setTransitionName(cardCover, "project-media");
        setTransitionName(cardTitle, "project-title");
        const transition = beginViewTransition(() => {
          clearTransitionNames(card, cardCover, cardTitle);
          update();
          setTransitionName(detail, "project-frame");
          setTransitionName(detail.querySelector<HTMLElement>(".project-hero"), "project-media");
          setTransitionName(detail.querySelector<HTMLElement>(":scope > h2"), "project-title");
        });
        const clear = () => {
          clearTransitionNames(
            detail,
            detail.querySelector<HTMLElement>(".project-hero"),
            detail.querySelector<HTMLElement>(":scope > h2"),
          );
          focusTitle();
        };
        transition?.finished.finally(clear);
        if (!transition) requestAnimationFrame(clear);
      }

      function openGalleryPhoto(photo: HTMLAnchorElement) {
        if (activeGalleryPhoto) return;
        activeGalleryPhoto = photo;
        galleryLightboxImage.src = photo.href;
        back.hidden = true;
        const update = () => {
          galleryLightbox.hidden = false;
        };
        const focusClose = () => galleryLightboxClose.focus({ preventScroll: true });
        if (!(document as TransitionDocument).startViewTransition) {
          animateFallbackFrame(photo, update, () => galleryLightboxFrame, focusClose);
          return;
        }
        setTransitionName(photo, "gallery-photo");
        const transition = beginViewTransition(() => {
          clearTransitionNames(photo);
          update();
          setTransitionName(galleryLightboxFrame, "gallery-photo");
        });
        const clear = () => {
          clearTransitionNames(galleryLightboxFrame);
          focusClose();
        };
        transition?.finished.finally(clear);
        if (!transition) requestAnimationFrame(clear);
      }

      function closeGalleryPhoto(animated = true) {
        const photo = activeGalleryPhoto;
        if (!photo) return;
        if (!animated) {
          galleryLightbox.hidden = true;
          galleryLightboxImage.removeAttribute("src");
          activeGalleryPhoto = null;
          return;
        }
        const update = () => {
          galleryLightbox.hidden = true;
          activeGalleryPhoto = null;
        };
        const finish = () => {
          galleryLightboxImage.removeAttribute("src");
          back.hidden = false;
          photo.focus({ preventScroll: true });
        };
        if (!(document as TransitionDocument).startViewTransition) {
          animateFallbackFrame(galleryLightboxFrame, update, () => photo, finish);
          return;
        }
        setTransitionName(galleryLightboxFrame, "gallery-photo");
        const transition = beginViewTransition(() => {
          clearTransitionNames(galleryLightboxFrame);
          update();
          setTransitionName(photo, "gallery-photo");
        });
        const clear = () => {
          clearTransitionNames(photo);
          finish();
        };
        transition?.finished.finally(clear);
        if (!transition) requestAnimationFrame(clear);
      }

      function setPortalFrame(frame: PortalFrame) {
        panel.style.setProperty("--portal-top", `${frame.top}px`);
        panel.style.setProperty("--portal-right", `${frame.right}px`);
        panel.style.setProperty("--portal-bottom", `${frame.bottom}px`);
        panel.style.setProperty("--portal-left", `${frame.left}px`);
      }

      function showMetabolisSlide(index: number, replay = true) {
        activeMetabolisSlide = (index + metabolisSlides.length) % metabolisSlides.length;
        metabolisOpening.style.setProperty("--metabolis-slide", String(activeMetabolisSlide));
        metabolisSlideButtons.forEach((button, buttonIndex) => {
          const active = buttonIndex === activeMetabolisSlide;
          button.classList.toggle("active", active);
          button.setAttribute("aria-pressed", String(active));
        });
        metabolisVideos.forEach((video, videoIndex) => {
          if (videoIndex === activeMetabolisSlide) {
            if (replay) video.currentTime = 0;
            void video.play().catch(() => undefined);
          } else {
            video.pause();
          }
        });
      }

      function pauseMetabolisOpening() {
        metabolisVideos.forEach((video) => video.pause());
      }

      function showContinueScreen(screen: "desktop" | "games" | "metabolis" | "cycling") {
        continueContent.dataset.continueApp = screen;
        back.textContent = screen === "desktop" ? "← Back to the room" : "← Desktop";
        continueScreens.forEach((candidate) => {
          candidate.hidden = candidate.dataset.continueScreen !== screen;
        });
        if (screen === "metabolis") {
          showMetabolisSlide(0);
        } else {
          pauseMetabolisOpening();
        }
      }

      function showCyclingRide(rideId: string) {
        cyclingRoutes.forEach((route) => {
          route.hidden = route.dataset.cyclingRoute !== rideId;
        });
        cyclingRideButtons.forEach((button) => {
          const active = button.dataset.cyclingRide === rideId;
          button.classList.toggle("active", active);
          button.setAttribute("aria-pressed", String(active));
        });
      }

      continueContent.addEventListener("click", (event) => {
        const rideTrigger = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-cycling-ride]");
        if (rideTrigger?.dataset.cyclingRide) {
          showCyclingRide(rideTrigger.dataset.cyclingRide);
          return;
        }
        const slideTrigger = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-metabolis-slide]");
        if (slideTrigger?.dataset.metabolisSlide) {
          showMetabolisSlide(Number(slideTrigger.dataset.metabolisSlide));
          return;
        }
        if ((event.target as HTMLElement).closest("[data-metabolis-previous]")) {
          showMetabolisSlide(activeMetabolisSlide - 1);
          return;
        }
        if ((event.target as HTMLElement).closest("[data-metabolis-next]")) {
          showMetabolisSlide(activeMetabolisSlide + 1);
          return;
        }
        const trigger = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-continue-open]");
        const screen = trigger?.dataset.continueOpen;
        if (screen === "desktop" || screen === "games" || screen === "metabolis" || screen === "cycling") {
          showContinueScreen(screen);
          return;
        }
        if ((event.target as HTMLElement).closest("[data-metabolis-replay]")) {
          showMetabolisSlide(activeMetabolisSlide);
        }
      });

      let metabolisTouchStart = 0;
      metabolisOpening.addEventListener("touchstart", (event) => {
        metabolisTouchStart = event.changedTouches[0]?.clientX ?? 0;
      }, { passive: true });
      metabolisOpening.addEventListener("touchend", (event) => {
        const distance = (event.changedTouches[0]?.clientX ?? metabolisTouchStart) - metabolisTouchStart;
        if (Math.abs(distance) < 45) return;
        showMetabolisSlide(activeMetabolisSlide + (distance < 0 ? 1 : -1));
      }, { passive: true });

      function showPanel(view: ViewName) {
        const entry = byView.get(view);
        if (!entry) return;
        body.dataset.active = view;
        document.documentElement.style.setProperty("--active-primary", entry.colours[0]);
        document.documentElement.style.setProperty("--active-secondary", entry.colours[1]);
        document.documentElement.style.setProperty("--active-accent", entry.colours[2]);
        // The two screens and the window grow from their real room geometry
        // into readable HTML layers. The certificate shelf remains a direct app.
        const isContinue = view === "monitor";
        const isMac = view === "mac";
        const isCertificates = view === "achievements";
        const isGallery = view === "window";
        const isPortal = isContinue || isMac || isGallery;
        const isApp = isContinue || isMac || isCertificates || isGallery;
        standardPanel.hidden = isApp;
        continuePanel.hidden = !isContinue;
        projectsPanel.hidden = !isMac;
        certificatesPanel.hidden = !isCertificates;
        galleryPanel.hidden = !isGallery;
        panel.classList.toggle("app", isApp);
        panel.classList.toggle("framed", isMac);
        panel.classList.toggle("portal", isPortal);
        panel.classList.toggle("workspace", isContinue);
        panel.dataset.portal = isPortal ? view : "";
        body.dataset.layer = isApp ? "app" : "card";
        if (isApp) panel.scrollTo({ top: 0, behavior: "auto" });
        if (isMac) {
          showProjectGrid(false);
        } else if (isContinue) {
          showContinueScreen("desktop");
          back.textContent = "← Back to the room";
        } else {
          back.textContent = "← Back to the room";
        }
        if (!isApp) {
          panelTitle.textContent = entry.label;
          panelObject.textContent = entry.object;
          panelBody.textContent = entry.body;
          swatches.replaceChildren(
            ...entry.colours.map((colour) => {
              const swatch = document.createElement("span");
              swatch.style.background = colour;
              return swatch;
            }),
          );
        }
        panel.hidden = false;
        back.hidden = false;
        requestAnimationFrame(() => {
          panel.classList.add("on");
          scrim.classList.add("on");
        });
      }

      function hidePanel() {
        closeGalleryPhoto(false);
        pauseMetabolisOpening();
        back.hidden = true;
        body.dataset.active = "";
        body.dataset.layer = "";
        activeProject = null;
        back.textContent = "← Back to the room";
        panel.classList.remove("on");
        scrim.classList.remove("on");
        const closingDelay = panel.classList.contains("portal") ? 720 : 360;
        window.setTimeout(() => {
          if (!panel.classList.contains("on")) {
            panel.hidden = true;
            panel.dataset.portal = "";
          }
        }, closingDelay);
      }

      let open = (view: ViewName) => showPanel(view);
      let close = () => {
        hidePanel();
        back.hidden = true;
      };

      function requestClose() {
        if (activeGalleryPhoto) {
          closeGalleryPhoto();
          return;
        }
        if (body.dataset.active === "monitor" && continueContent.dataset.continueApp !== "desktop") {
          showContinueScreen("desktop");
          return;
        }
        if (body.dataset.active === "mac" && activeProject) {
          showProjectGrid(true);
          return;
        }
        close();
      }

      menu.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-view]");
        if (button?.dataset.view) open(button.dataset.view as ViewName);
      });
      projectGrid.addEventListener("click", (event) => {
        const card = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-project]");
        if (card?.dataset.project) showProject(card.dataset.project);
      });
      galleryPanel.addEventListener("click", (event) => {
        const mouseEvent = event as MouseEvent;
        const photo = (event.target as HTMLElement).closest<HTMLAnchorElement>("a.gallery-photo");
        if (!photo || mouseEvent.metaKey || mouseEvent.ctrlKey || mouseEvent.shiftKey || mouseEvent.altKey) return;
        event.preventDefault();
        openGalleryPhoto(photo);
      });
      galleryLightboxClose.addEventListener("click", () => closeGalleryPhoto());
      galleryLightbox.addEventListener("click", (event) => {
        if (event.target === galleryLightbox) closeGalleryPhoto();
      });
      back.addEventListener("click", requestClose);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") requestClose();
      });

      if (canRenderRoom()) {
        // Keep three.js behind this dynamic import. Phones never request it.
        const { createRoom } = await import("../../v4/room/scene");
        body.dataset.mode = "room";
        canvas.hidden = false;

        const room = createRoom({
          canvas,
          initialView: location.hash.slice(1) || undefined,
          onLeave() {
            hidePanel();
          },
          onArrive(view) {
            if (view === "wide") {
              back.hidden = true;
              hint.textContent = "Choose an object. Colour travels through the room as you enter.";
              return;
            }
            hint.textContent = "";
            showPanel(view as ViewName);
          },
          onHover(label) {
            hover.textContent = label ?? "";
            hover.classList.toggle("on", Boolean(label));
          },
          onPortalFrame(_view, frame) {
            setPortalFrame(frame);
          },
        });

        open = (view) => room.goTo(view);
        close = () => room.back();
      }
    </script>

    <script
      type="application/json"
      id="entry-data"
      is:inline
      set:html={JSON.stringify(entries)}></script>

    <style>
      :root {
        --ink: #292825;
        --graphite: #706c65;
        --paper: #fbfaf6;
        --void: #f4f1ea;
        --active-primary: #292825;
        --active-secondary: #706c65;
        --active-accent: #d8d3ca;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        min-height: 100%;
        margin: 0;
        background: var(--void);
        color: var(--ink);
        font-family: "Avenir Next", Avenir, "Helvetica Neue", Arial, sans-serif;
      }

      body[data-mode="room"] {
        overflow: hidden;
      }

      body::after {
        content: "";
        position: fixed;
        z-index: 10;
        inset: 0;
        pointer-events: none;
        opacity: 0.22;
        mix-blend-mode: multiply;
        background-image:
          repeating-linear-gradient(7deg, rgba(41, 40, 37, 0.025) 0 1px, transparent 1px 13px),
          repeating-linear-gradient(97deg, rgba(41, 40, 37, 0.018) 0 1px, transparent 1px 17px);
      }

      .shared-transition-clone {
        position: fixed !important;
        z-index: 9 !important;
        margin: 0 !important;
        overflow: hidden !important;
        pointer-events: none !important;
        background: var(--paper);
        box-shadow: 0 18px 54px rgba(41, 40, 37, 0.18);
        transform: none !important;
        transform-origin: top left;
      }

      .shared-transition-clone[data-project-detail] {
        padding: 16px;
      }

      .shared-transition-clone[data-project-detail] > h2 {
        margin: 8px 0 20px;
        font-size: clamp(32px, 5vw, 68px);
        line-height: 1.04;
      }

      .shared-transition-clone[data-project-detail] .project-content {
        opacity: 0.32;
      }

      #stage {
        position: fixed;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
      }

      .poster {
        position: fixed;
        inset: 0;
        overflow: hidden;
        background-color: var(--void);
        background-image: radial-gradient(circle at 53% 24%, #fff 0 8%, transparent 42%);
        transition: background-color 0.55s ease;
      }

      body[data-mode="room"] .poster {
        display: none;
      }

      .poster > div {
        position: absolute;
        transition:
          background-color 0.55s ease,
          border-color 0.55s ease,
          box-shadow 0.55s ease;
      }

      .poster-room {
        inset: 8% 5% 7%;
        border: 2px solid rgba(41, 40, 37, 0.38);
        clip-path: polygon(16% 11%, 84% 11%, 100% 0, 100% 100%, 0 100%, 0 0);
      }

      .poster-window {
        top: 17%;
        left: 40%;
        width: 28%;
        height: 38%;
        border: 2px solid var(--ink);
        background: var(--paper);
      }

      .poster-window::before,
      .poster-window::after {
        content: "";
        position: absolute;
        background: rgba(41, 40, 37, 0.62);
      }

      .poster-window::before {
        left: 50%;
        top: 0;
        width: 1px;
        height: 100%;
      }

      .poster-window::after {
        top: 50%;
        left: 0;
        width: 100%;
        height: 1px;
      }

      .poster-sill {
        top: 55%;
        left: 37%;
        width: 34%;
        height: 3%;
        border: 2px solid var(--ink);
        background: var(--paper);
        transform: perspective(360px) rotateX(52deg);
      }

      .poster-desk {
        left: -3%;
        bottom: 16%;
        width: 48%;
        height: 8%;
        border: 2px solid var(--ink);
        background: var(--paper);
        transform: skewY(5deg);
      }

      .poster-desk-cabinet {
        top: 15%;
        left: 8%;
        width: 28%;
        height: 16%;
        border: 2px solid var(--ink);
        background: var(--paper);
        transform: skewY(4deg);
      }

      .poster-monitor {
        left: 25%;
        bottom: 24%;
        width: 10%;
        height: 15%;
        border: 2px solid var(--ink);
        background: var(--paper);
      }

      .poster-monitor::before {
        content: "";
        position: absolute;
        left: 47%;
        top: 100%;
        width: 3px;
        height: 18px;
        background: var(--ink);
        box-shadow: -10px 17px 0 -1px var(--ink), 10px 17px 0 -1px var(--ink);
      }

      .poster-achievements {
        top: 21%;
        left: 2%;
        width: 14%;
        height: 25%;
        border: 2px solid var(--ink);
        background: var(--paper);
      }

      .poster-achievements::before,
      .poster-achievements::after {
        content: "";
        position: absolute;
        background: var(--ink);
      }

      .poster-achievements::before {
        left: 33%;
        top: 0;
        width: 1px;
        height: 100%;
        box-shadow: calc(33% + 34px) 0 0 var(--ink);
      }

      .poster-achievements::after {
        left: 0;
        top: 50%;
        width: 100%;
        height: 1px;
      }

      .poster-chair {
        left: 31%;
        bottom: 7%;
        width: 11%;
        height: 27%;
        border: 2px solid var(--ink);
        border-radius: 14% 32% 6% 9%;
        background: var(--paper);
        transform: rotate(-4deg);
      }

      .poster-figure {
        left: 32.5%;
        bottom: 21%;
        width: 7.5%;
        height: 19%;
        border: 2px solid var(--ink);
        border-radius: 22% 22% 8% 8%;
        background: color-mix(in srgb, var(--graphite) 10%, var(--paper));
        transform: rotate(-4deg);
      }

      .poster-figure::before {
        content: "";
        position: absolute;
        top: -57%;
        left: 3%;
        width: 94%;
        height: 53%;
        box-sizing: border-box;
        border: 2px solid var(--ink);
        border-radius: 34% 34% 42% 42%;
        background: color-mix(in srgb, var(--graphite) 6%, var(--paper));
      }

      .poster-figure::after {
        content: "";
        position: absolute;
        top: -64%;
        left: -1%;
        width: 103%;
        height: 27%;
        background: var(--ink);
        clip-path: polygon(0 68%, 7% 22%, 20% 45%, 29% 0, 40% 39%, 54% 4%, 65% 38%, 79% 9%, 86% 48%, 100% 31%, 94% 100%, 12% 100%);
      }

      .poster-figure i,
      .poster-figure b,
      .poster-figure span {
        position: absolute;
        display: block;
        width: 12px;
        background: color-mix(in srgb, var(--graphite) 10%, var(--paper));
        border: 1px solid var(--ink);
        transform-origin: top;
      }

      .poster-figure i {
        top: 17%;
        left: 4%;
        height: 72%;
        transform: rotate(29deg);
      }

      .poster-figure b {
        top: 17%;
        right: 4%;
        height: 72%;
        transform: rotate(-24deg);
      }

      .poster-figure span {
        top: 92%;
        left: -8%;
        width: 44px;
        height: 48px;
        border: 0;
        background:
          linear-gradient(90deg, var(--graphite), var(--graphite)) 0 0 / 28px 8px no-repeat,
          linear-gradient(var(--graphite), var(--graphite)) 22px 5px / 8px 36px no-repeat,
          linear-gradient(90deg, var(--graphite), var(--graphite)) 3px 12px / 29px 8px no-repeat,
          linear-gradient(var(--graphite), var(--graphite)) 26px 17px / 8px 30px no-repeat;
        transform: none;
        box-shadow: none;
      }

      .poster-bed {
        right: -4%;
        bottom: 9%;
        width: 41%;
        height: 19%;
        border: 2px solid var(--ink);
        border-radius: 3% 4% 1% 2%;
        background: var(--paper);
        transform: skewY(-5deg);
      }

      .poster-bed::before {
        content: "";
        position: absolute;
        top: -18%;
        left: 12%;
        width: 38%;
        height: 31%;
        border: 2px solid var(--ink);
        border-radius: 45%;
        background: var(--paper);
      }

      .poster-bed-cabinet {
        top: 12%;
        right: 4%;
        width: 29%;
        height: 17%;
        border: 2px solid var(--ink);
        background: var(--paper);
        transform: skewY(-4deg);
      }

      .poster-mac {
        right: 18%;
        bottom: 27%;
        width: 11%;
        height: 12%;
        border: 2px solid var(--ink);
        background: var(--paper);
        transform: skewY(-5deg);
      }

      .poster-mac::after {
        content: "";
        position: absolute;
        left: -10%;
        top: 100%;
        width: 120%;
        height: 16%;
        border: 2px solid var(--ink);
        background: var(--paper);
      }

