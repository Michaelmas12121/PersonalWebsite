      .scrim {
        position: fixed;
        z-index: 1;
        inset: 0;
        pointer-events: none;
        background: rgba(251, 250, 246, 0.48);
        opacity: 0;
        transition: opacity 0.45s ease;
      }

      .scrim.on {
        opacity: 1;
      }

      .ui {
        position: fixed;
        z-index: 2;
      }

      .top {
        top: clamp(20px, 3.5vh, 42px);
        left: clamp(22px, 4vw, 58px);
      }

      .name,
      .version,
      .hint {
        margin: 0;
      }

      .name {
        font-size: clamp(18px, 2vw, 24px);
        font-weight: 500;
        letter-spacing: -0.02em;
      }

      .version {
        margin-top: 5px;
        color: var(--graphite);
        font-size: 11px;
        letter-spacing: 0.07em;
      }

      .hint {
        max-width: 440px;
        margin-top: 10px;
        color: var(--graphite);
        font-size: 12px;
        line-height: 1.5;
      }

      .menu {
        left: clamp(22px, 4vw, 58px);
        bottom: clamp(24px, 5vh, 56px);
        display: grid;
        gap: 2px;
      }

      .menu button {
        display: grid;
        grid-template-columns: 8px auto auto;
        gap: 10px;
        align-items: baseline;
        padding: 5px 0;
        border: 0;
        background: transparent;
        color: rgba(41, 40, 37, 0.58);
        font: inherit;
        text-align: left;
        cursor: pointer;
        transition: color 0.2s ease;
      }

      .menu button:hover,
      .menu button:focus-visible {
        color: var(--ink);
        outline: none;
      }

      .mark {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
        opacity: 0;
        transition: opacity 0.2s ease;
      }

      .menu button:hover .mark,
      .menu button:focus-visible .mark {
        opacity: 1;
      }

      .label {
        font-size: clamp(17px, 2vw, 23px);
      }

      .note {
        color: var(--graphite);
        font-size: 11.5px;
      }

      .back {
        z-index: 5;
        top: clamp(20px, 3.5vh, 42px);
        right: clamp(22px, 4vw, 58px);
        padding: 8px 15px;
        border: 1px solid rgba(41, 40, 37, 0.24);
        border-radius: 999px;
        background: rgba(251, 250, 246, 0.9);
        color: var(--ink);
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }

      .panel {
        --portal-top: 36vh;
        --portal-right: 38vw;
        --portal-bottom: 34vh;
        --portal-left: 38vw;
        right: clamp(22px, 4vw, 58px);
        bottom: clamp(24px, 5vh, 56px);
        width: min(390px, 42vw);
        padding: 20px 22px 22px;
        border: 1px solid color-mix(in srgb, var(--active-primary) 34%, transparent);
        border-left: 4px solid var(--active-primary);
        background:
          linear-gradient(135deg, color-mix(in srgb, var(--active-secondary) 13%, var(--paper)), var(--paper) 58%),
          var(--paper);
        box-shadow: 0 20px 60px rgba(41, 40, 37, 0.13);
        opacity: 0;
        transform: translateY(10px);
        transition:
          opacity 0.36s ease,
          transform 0.36s ease;
      }

      .panel.on {
        opacity: 1;
        transform: none;
      }

      .panel.app {
        z-index: 4;
        inset: 0;
        width: 100vw;
        max-height: none;
        padding: 0;
        overflow-y: auto;
        border: 0;
        background:
          radial-gradient(circle at 18% 8%, color-mix(in srgb, var(--active-secondary) 14%, transparent), transparent 32%),
          linear-gradient(145deg, var(--paper), color-mix(in srgb, var(--active-accent) 8%, var(--paper)));
        box-shadow: none;
        overscroll-behavior: contain;
        transform: scale(0.992);
      }

      .panel.app.on {
        transform: none;
      }

      .panel.portal {
        opacity: 0.96;
        transform: none;
        clip-path: inset(
          var(--portal-top)
          var(--portal-right)
          var(--portal-bottom)
          var(--portal-left)
          round 8px
        );
        transition:
          clip-path 0.68s cubic-bezier(0.22, 0.72, 0.18, 1),
          opacity 0.22s ease;
      }

      .panel.portal.on {
        opacity: 1;
        clip-path: inset(0 0 0 0 round 0);
      }

      .panel[data-portal="monitor"] {
        --portal-top: 37vh;
        --portal-right: 40vw;
        --portal-bottom: 33vh;
        --portal-left: 39vw;
      }

      .panel[data-portal="mac"] {
        --portal-top: 36vh;
        --portal-right: 18vw;
        --portal-bottom: 30vh;
        --portal-left: 52vw;
      }

      .panel[data-portal="window"] {
        --portal-top: 16vh;
        --portal-right: 24vw;
        --portal-bottom: 20vh;
        --portal-left: 24vw;
      }

      .panel.portal .standard-content,
      .panel.portal .continue-content,
      .panel.portal .app-content,
      .panel.portal .mac-app-bar {
        opacity: 0;
        transform: translateY(16px);
        transition:
          opacity 0.18s ease,
          transform 0.24s ease;
      }

      .panel.portal.on .standard-content,
      .panel.portal.on .continue-content,
      .panel.portal.on .app-content,
      .panel.portal.on .mac-app-bar {
        opacity: 1;
        transform: none;
        transition:
          opacity 0.42s ease 0.3s,
          transform 0.5s cubic-bezier(0.22, 0.72, 0.18, 1) 0.3s;
      }

      .panel.workspace {
        background:
          radial-gradient(circle at 88% 12%, rgba(255, 255, 255, 0.96), transparent 25%),
          repeating-radial-gradient(ellipse at 8% 34%, transparent 0 27px, rgba(213, 168, 74, 0.07) 28px 29px),
          linear-gradient(138deg, #fbf8ef, #f2eee3 58%, #edf3f0);
      }

      .continue-content {
        width: 100%;
        min-height: 100svh;
        color: #27383a;
      }

      .continue-menu-bar {
        position: fixed;
        z-index: 5;
        top: 0;
        right: 0;
        left: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 64px;
        padding: 0 200px 0 clamp(24px, 4vw, 58px);
        border-bottom: 1px solid rgba(47, 105, 112, 0.1);
        background: rgba(251, 248, 239, 0.76);
        backdrop-filter: blur(16px);
      }

      .continue-menu-bar > div {
        display: flex;
        gap: 26px;
        align-items: center;
      }

      .continue-menu-bar strong {
        color: #b27d21;
        font-size: 19px;
        font-weight: 500;
        letter-spacing: 0.28em;
        text-transform: uppercase;
      }

      .continue-menu-bar span,
      .computer-status {
        color: #52777b;
        font-size: 12px;
      }

      .computer-status {
        gap: 14px !important;
      }

      .status-signal {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--active-primary);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--active-primary) 12%, transparent);
      }

      .continue-desktop {
        position: relative;
        display: grid;
        place-items: center;
        min-height: 100svh;
        padding: 104px 6vw 132px;
      }

      .desktop-welcome {
        display: grid;
        justify-items: center;
        max-width: 520px;
        text-align: center;
      }

      .desktop-welcome p,
      .desktop-welcome span { margin: 0; }

      .desktop-welcome p {
        color: #b27d21;
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .desktop-welcome h2 {
        margin: 10px 0 12px;
        color: #27383a;
        font-size: clamp(52px, 8vw, 108px);
        font-weight: 360;
        letter-spacing: -0.05em;
        line-height: 0.9;
      }

      .desktop-welcome span {
        max-width: 390px;
        color: #6e8889;
        font-size: 13px;
        line-height: 1.7;
      }

      .desktop-shortcut {
        position: absolute;
        top: 24%;
        left: 7%;
        display: grid;
        justify-items: center;
        gap: 9px;
        width: 92px;
        padding: 6px;
        border: 0;
        background: transparent;
        color: #27383a;
        font: inherit;
        cursor: pointer;
      }

      .games-shortcut { top: 20%; }
      .cycling-shortcut { top: calc(20% + 112px); }

      .folder-icon,
      .route-app-icon {
        position: relative;
        display: block;
        width: 48px;
        height: 38px;
        border: 1px solid color-mix(in srgb, var(--active-primary) 60%, transparent);
        border-radius: 8px;
        background: linear-gradient(145deg, #cfe0dc, #8fb3b2);
        box-shadow: 0 6px 14px rgba(47, 105, 112, 0.14);
      }

      .folder-icon::before {
        content: "";
        position: absolute;
        bottom: 100%;
        left: 5px;
        width: 20px;
        height: 7px;
        border: inherit;
        border-bottom: 0;
        border-radius: 5px 5px 0 0;
        background: #cfe0dc;
      }

      .route-app-icon {
        overflow: hidden;
        height: 48px;
        border-radius: 12px;
        background:
          linear-gradient(33deg, transparent 30%, rgba(47, 105, 112, 0.17) 31% 34%, transparent 35%),
          linear-gradient(110deg, transparent 54%, rgba(47, 105, 112, 0.16) 55% 59%, transparent 60%),
          #dce8e4;
      }

      .route-app-icon i,
      .route-app-icon b {
        position: absolute;
        top: 10px;
        left: 8px;
        width: 32px;
        height: 27px;
        border: 4px solid #e9a137;
        border-top-color: transparent;
        border-left-width: 3px;
        border-radius: 46% 48% 36% 54%;
        transform: rotate(-14deg);
      }

      .continue-os-window {
        position: fixed;
        z-index: 4;
        inset: 64px 0 0;
        width: 100vw;
        overflow: hidden;
        border: 0;
        border-radius: 0;
        background: #fffdfa;
        box-shadow: none;
        backdrop-filter: blur(22px);
      }

      .os-title-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 64px;
        padding: 0 24px;
        border-bottom: 1px solid rgba(47, 105, 112, 0.18);
        background: rgba(239, 246, 243, 0.68);
      }

      .os-title-bar > div {
        display: flex;
        gap: 16px;
        align-items: center;
      }

      .os-title-bar .folder-icon {
        width: 32px;
        height: 25px;
        border-radius: 5px;
        box-shadow: none;
      }

      .window-actions {
        display: flex;
        gap: 20px;
      }

      .window-actions i {
        width: 12px;
        height: 12px;
        border: 1px solid #6e9295;
        border-radius: 3px;
      }

      .game-library {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: clamp(18px, 2.6vw, 42px);
        align-items: start;
        height: calc(100svh - 128px);
        min-height: 0;
        padding: clamp(28px, 5vh, 64px) clamp(32px, 5vw, 82px);
      }

      .game-tile {
        display: grid;
        align-content: start;
        justify-items: center;
        gap: 13px;
        min-width: 0;
        padding: 10px 10px 20px;
        border: 1px solid rgba(47, 105, 112, 0.18);
        border-radius: 15px;
        background: rgba(255, 255, 255, 0.68);
        color: #27383a;
        font: inherit;
      }

      .metabolis-tile {
        border: 2px solid #2f8b91;
        box-shadow: 0 14px 30px rgba(47, 105, 112, 0.12);
        cursor: pointer;
      }

      .game-cover,
      .game-cover picture,
      .game-cover img {
        display: block;
        width: 100%;
      }

      .game-cover {
        overflow: hidden;
        aspect-ratio: 16 / 9;
        border-radius: 9px;
        background: #f28dae;
      }

      .game-cover img {
        height: 100%;
        object-fit: contain;
        image-rendering: pixelated;
      }

      .game-tile strong {
        font-size: clamp(16px, 1.5vw, 22px);
        font-weight: 500;
      }

      .active-game,
      .future-game > span:last-child {
        color: var(--active-primary);
        font-size: 11px;
      }

      .active-game i {
        display: inline-block;
        width: 7px;
        height: 7px;
        margin-right: 7px;
        border-radius: 50%;
        background: var(--active-accent);
      }

      .future-game {
        opacity: 0.54;
      }

      .future-game-icon {
        position: relative;
        display: grid;
        place-items: center;
        width: 100%;
        aspect-ratio: 16 / 9;
        border: 1px dashed #8cafb0;
        border-radius: 9px;
      }

      .future-game-icon::before,
      .future-game-icon::after {
        content: "";
        position: absolute;
        width: 30%;
        height: 22%;
        border: 4px solid #7fa2a4;
        border-radius: 48% 48% 34% 34%;
      }

      .future-game-icon::before { left: 25%; transform: rotate(18deg); }
      .future-game-icon::after { right: 25%; transform: rotate(-18deg); }

      .future-game-icon i,
      .future-game-icon b {
        position: absolute;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #7fa2a4;
      }

      .future-game-icon i { left: 42%; }
      .future-game-icon b { right: 42%; }

      .window-back,
      .window-replay {
        padding: 7px 11px;
        border: 1px solid rgba(47, 105, 112, 0.24);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.7);
        color: var(--active-primary);
        font: inherit;
        font-size: 11px;
        cursor: pointer;
      }

      .metabolis-deck {
        --metabolis-slide: 0;
        position: relative;
        overflow: hidden;
        height: calc(100svh - 128px);
        background: #191327;
        color: #fffaf0;
        touch-action: pan-y;
      }

      .metabolis-slides {
        display: flex;
        width: 400%;
        height: 100%;
        transform: translateX(calc(var(--metabolis-slide) * -25%));
        transition: transform 620ms cubic-bezier(0.22, 0.72, 0.18, 1);
      }

      .metabolis-slide {
        position: relative;
        flex: 0 0 25%;
        overflow: hidden;
        background: #191327;
      }

      .metabolis-slide video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        image-rendering: pixelated;
      }

      .slide-shade,
      .metabolis-slide::after {
        position: absolute;
        content: "";
        inset: 0;
        background: linear-gradient(90deg, rgba(25, 19, 39, 0.72), transparent 60%), linear-gradient(transparent 62%, rgba(25, 19, 39, 0.74));
        pointer-events: none;
      }

      .slide-copy {
        position: absolute;
        z-index: 2;
        right: clamp(70px, 8vw, 120px);
        bottom: clamp(82px, 10vh, 130px);
        left: clamp(70px, 8vw, 120px);
        display: grid;
        gap: 7px;
        max-width: 620px;
      }

      .slide-copy p,
      .slide-copy span { margin: 0; }
      .slide-copy p { color: #f3bd76; font-size: 10px; letter-spacing: 0.13em; text-transform: uppercase; }
      .slide-copy h3 { margin: 0; font-size: clamp(48px, 7vw, 102px); font-weight: 430; line-height: 0.94; }
      .slide-copy span { max-width: 520px; font-size: clamp(11px, 1.2vw, 15px); line-height: 1.55; }
      .metabolis-slide:not(.title-slide) .slide-copy h3 { font-size: clamp(42px, 5.2vw, 76px); }

      .slide-arrow {
        position: absolute;
        z-index: 4;
        top: 50%;
        display: grid;
        place-items: center;
        width: 46px;
        height: 46px;
        border: 1px solid rgba(255, 250, 240, 0.48);
        border-radius: 50%;
        background: rgba(25, 19, 39, 0.64);
        color: #fffaf0;
        font: 21px/1 inherit;
        cursor: pointer;
        transform: translateY(-50%);
      }

      .slide-arrow.previous { left: 22px; }
      .slide-arrow.next { right: 22px; }

      .slide-dots {
        position: absolute;
        z-index: 4;
        right: 50%;
        bottom: 19px;
        display: flex;
        gap: 7px;
        padding: 7px;
        border: 1px solid rgba(255, 250, 240, 0.28);
        border-radius: 12px;
        background: rgba(25, 19, 39, 0.72);
        transform: translateX(50%);
      }

      .slide-dots button {
        display: flex;
        gap: 6px;
        align-items: center;
        padding: 7px 10px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: rgba(255, 250, 240, 0.7);
        font: 10px/1 inherit;
        cursor: pointer;
      }

      .slide-dots button.active { background: #fffaf0; color: #35223d; }
      .slide-dots span { color: #e19c67; font-size: 8px; }

      .cycling-window { width: 100vw; }

      .ride-count { color: var(--active-primary); font-size: 11px; }

      .cycling-app-layout {
        display: grid;
        grid-template-columns: 250px minmax(0, 1fr);
        height: calc(100svh - 128px);
        min-height: 0;
      }

      .ride-list {
        display: flex;
        flex-direction: column;
        min-height: 0;
        padding: 22px 14px 14px;
        border-right: 1px solid rgba(47, 105, 112, 0.15);
        background: rgba(239, 246, 243, 0.48);
      }

      .ride-list-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        padding: 0 7px 16px;
      }

      .ride-list-heading p {
        margin: 0 0 5px;
        color: #789093;
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .ride-list-heading strong { color: #27383a; font-size: 17px; font-weight: 520; }
      .ride-list-heading > span { color: #cf7847; font-size: 11px; }

      .ride-list-scroll {
        display: grid;
        gap: 7px;
        min-height: 0;
        padding: 1px 5px 18px 1px;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-color: rgba(47, 105, 112, 0.32) transparent;
        scrollbar-width: thin;
      }

      .ride-entry {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 3px 10px;
        width: 100%;
        padding: 11px 12px;
        border: 1px solid transparent;
        border-radius: 10px;
        background: rgba(255, 253, 250, 0.62);
        color: #27383a;
        font: inherit;
        text-align: left;
        transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
      }

      .ride-entry:hover { transform: translateX(2px); }
      .ride-entry.active { border-color: rgba(47, 105, 112, 0.34); background: #fffdfa; }
      .ride-entry > span { color: #789093; font-size: 9px; letter-spacing: 0.07em; text-transform: uppercase; }
      .ride-entry strong { grid-row: span 2; align-self: center; font-size: 17px; font-weight: 480; }
      .ride-entry small { color: #55777a; font-size: 9px; }

      .cycling-route-stage { position: relative; min-width: 0; min-height: 0; background: #edf3f0; }

      .cycling-map {
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto;
        height: 100%;
        min-height: 0;
        overflow: hidden;
        background: #edf3f0;
      }

      .route-image {
        position: relative;
        display: grid;
        min-height: 0;
        place-items: center;
        overflow: hidden;
        padding: 16px 20px;
        background: #dbe6e2;
      }

      .route-image picture,
      .route-image picture img,
      .route-image > img {
        display: block;
        width: 100%;
        height: 100%;
      }

      .route-image picture img,
      .route-image > img {
        object-fit: contain;
      }

      .cycling-map[hidden] { display: none; }

      .route-label {
        position: absolute;
        top: 20px;
        left: 20px;
        display: grid;
        gap: 3px;
        padding: 12px 15px;
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 12px;
        background: rgba(255, 253, 250, 0.86);
        color: #27383a;
        backdrop-filter: blur(12px);
      }

      .route-label span { color: #cf7847; font-size: 9px; letter-spacing: 0.09em; text-transform: uppercase; }
      .route-label strong { font-size: 15px; font-weight: 520; }

      .route-details {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 24px;
        align-items: center;
        min-height: 122px;
        padding: 18px 28px;
        border-top: 1px solid rgba(47, 105, 112, 0.15);
        background: #fffdfa;
      }

      .cycling-map .ride-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin: 0;
        padding: 0;
      }

      .ride-stats div { display: flex; flex-direction: column-reverse; gap: 4px; }
      .ride-stats dt { color: #67878a; font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; }
      .ride-stats dd { margin: 0; color: #27383a; font-size: clamp(20px, 2.2vw, 34px); line-height: 1; }
      .ride-stats dd span { font-size: 10px; }

      .route-privacy {
        max-width: 230px;
        margin: 0;
        padding: 9px 12px;
        border-left: 1px solid rgba(47, 105, 112, 0.22);
        color: #56787b;
        font-size: 9px;
        line-height: 1.55;
      }

      .mobile-ride-nav { display: none; }

      .computer-dock {
        position: fixed;
        z-index: 6;
        bottom: 18px;
        left: 50%;
        display: flex;
        gap: 18px;
        align-items: center;
        padding: 10px 18px;
        border: 1px solid rgba(47, 105, 112, 0.25);
        border-radius: 18px;
        background: rgba(255, 253, 250, 0.84);
        box-shadow: 0 14px 36px rgba(47, 74, 75, 0.13);
        backdrop-filter: blur(16px);
        transform: translateX(-50%);
      }

      .continue-content:not([data-continue-app="desktop"]) .computer-dock {
        display: none;
      }

      .computer-dock button {
        display: grid;
        justify-items: center;
        gap: 4px;
        min-width: 58px;
        padding: 0;
        border: 0;
        background: transparent;
        color: #27383a;
        font: inherit;
        font-size: 9px;
        cursor: pointer;
      }

      .computer-dock .folder-icon { width: 36px; height: 28px; border-radius: 6px; }
      .computer-dock .route-app-icon { width: 36px; height: 36px; border-radius: 9px; }
      .computer-dock .route-app-icon i,
      .computer-dock .route-app-icon b { top: 7px; left: 6px; width: 24px; height: 20px; border-width: 3px; }
      .computer-dock > i { width: 1px; height: 42px; background: rgba(47, 105, 112, 0.2); }

      .continue-content:not([data-continue-app="desktop"]) .desktop-shortcut,
      .continue-content:not([data-continue-app="desktop"]) .desktop-welcome {
        opacity: 0.32;
      }

      .panel.portal .project-card,
      .panel.portal .gallery-photo,
      .panel.portal .continue-os-window {
        opacity: 0;
        transform: translateY(22px) scale(0.992);
      }

      .panel.portal.on .project-card,
      .panel.portal.on .gallery-photo,
      .panel.portal.on .continue-os-window {
        animation: portal-item-in 0.5s cubic-bezier(0.22, 0.72, 0.18, 1) both;
        animation-delay: calc(0.46s + var(--reveal-index, 0) * 55ms);
      }

      .panel[data-portal="window"] #gallery-panel::before {
        content: "";
        position: fixed;
        z-index: 3;
        inset: 0;
        pointer-events: none;
        opacity: 0.52;
        background:
          linear-gradient(90deg, transparent 33.2%, var(--active-primary) 33.25% 33.4%, transparent 33.45%),
          linear-gradient(90deg, transparent 66.5%, var(--active-primary) 66.55% 66.7%, transparent 66.75%);
        transition: opacity 0.48s ease 0.28s;
      }

      .panel[data-portal="window"].on #gallery-panel::before {
        opacity: 0;
      }

      @keyframes portal-item-in {
        to {
          opacity: 1;
          transform: none;
        }
      }

      body[data-layer="app"] .back {
        top: 10px;
        right: 18px;
        border-color: color-mix(in srgb, var(--active-primary) 28%, transparent);
        background: color-mix(in srgb, var(--paper) 88%, var(--active-secondary));
      }

      .mac-app-bar {
        position: sticky;
        z-index: 2;
        top: 0;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        min-height: 52px;
        padding: 0 166px 0 18px;
        border-bottom: 1px solid color-mix(in srgb, var(--active-primary) 20%, transparent);
        background: color-mix(in srgb, var(--paper) 90%, var(--active-secondary));
        backdrop-filter: blur(18px);
        color: #5c5751;
        font-size: 11px;
      }

      .mac-app-bar > span:nth-child(2) {
        color: var(--ink);
        font-weight: 500;
      }

      .mac-app-bar > span:last-child {
        justify-self: end;
      }

      .mac-window-controls {
        display: flex;
        gap: 7px;
      }

      .mac-window-controls i {
        width: 10px;
        height: 10px;
        border: 1px solid rgba(41, 40, 37, 0.18);
        border-radius: 50%;
        background: var(--active-primary);
      }

      .mac-window-controls i:nth-child(2) {
        background: var(--active-secondary);
      }

      .mac-window-controls i:nth-child(3) {
        background: var(--active-accent);
      }

      /* The Mac is the only full-screen view with window chrome above it. */
      .app-content {
        width: min(1320px, calc(100% - clamp(40px, 9vw, 144px)));
        min-height: 100svh;
        margin: 0 auto;
        padding: clamp(36px, 6vh, 72px) 0 80px;
      }

      .panel.framed .app-content {
        min-height: calc(100svh - 52px);
      }

      .panel-state,
      .panel-object,
      .panel-body {
        margin: 0;
      }

      .panel-state {
        color: var(--active-primary);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .panel h2 {
        margin: 7px 0 5px;
        font-size: clamp(22px, 2.5vw, 30px);
        font-weight: 500;
        letter-spacing: -0.025em;
      }

      .panel-object {
        color: var(--active-primary);
        font-size: 11.5px;
      }

      .panel-body {
        margin-top: 16px;
        color: #4f4c47;
        font-size: 13.5px;
        line-height: 1.72;
      }

      .swatches {
        display: flex;
        gap: 7px;
        margin-top: 19px;
      }

      .swatches span {
        width: 28px;
        height: 5px;
        border-radius: 999px;
      }

      .projects-heading {
        display: flex;
        gap: 48px;
        align-items: end;
        justify-content: space-between;
        padding-bottom: 26px;
        border-bottom: 1px solid color-mix(in srgb, var(--active-primary) 24%, transparent);
      }

      .projects-heading h2 {
        font-size: clamp(36px, 5vw, 68px);
      }

      .projects-heading h2,
      .projects-heading p {
        margin: 0;
      }

      .projects-heading > p {
        max-width: 320px;
        color: #5c5751;
        font-size: 13px;
        line-height: 1.55;
        text-align: right;
      }

      .project-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(16px, 2.5vw, 30px);
        margin-top: 32px;
      }

      .project-grid[hidden],
      .project-reader[hidden],
      [data-project-detail][hidden] {
        display: none !important;
      }

      .project-card {
        display: flex;
        min-width: 0;
        padding: 0 0 15px;
        overflow: hidden;
        flex-direction: column;
        border: 1px solid color-mix(in srgb, var(--active-primary) 26%, transparent);
        background: color-mix(in srgb, var(--paper) 92%, var(--active-secondary));
        color: var(--ink);
        font: inherit;
        text-align: left;
        cursor: pointer;
        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease,
          transform 0.2s ease;
      }

      .project-card:hover,
      .project-card:focus-visible {
        border-color: var(--active-primary);
        box-shadow: 0 12px 28px rgba(41, 40, 37, 0.1);
        outline: none;
        transform: translateY(-2px);
      }

      .project-cover {
        position: relative;
        display: block;
        width: 100%;
        aspect-ratio: 4 / 3;
        margin-bottom: 13px;
        overflow: hidden;
        background:
          linear-gradient(145deg, var(--active-primary), var(--active-secondary) 72%, var(--active-accent));
      }

      .project-cover :global(img) {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .project-lines {
        position: absolute;
        inset: 22% 16%;
        border: 1px solid rgba(251, 250, 246, 0.78);
        transform: rotate(-3deg);
      }

      .project-lines::before,
      .project-lines::after,
      .project-lines i,
      .project-lines b {
        content: "";
        position: absolute;
        display: block;
        height: 1px;
        background: rgba(251, 250, 246, 0.72);
      }

      .project-lines::before {
        top: 27%;
        right: 12%;
        left: 12%;
      }

      .project-lines::after {
        top: 55%;
        right: 20%;
        left: 12%;
      }

      .project-lines i {
        top: 72%;
        right: 33%;
        left: 12%;
      }

      .project-lines b {
        top: 10%;
        bottom: 10%;
        left: 24%;
        width: 1px;
        height: auto;
      }

      .project-context,
      .project-card strong,
      .project-summary,
      .project-open {
        margin-right: 14px;
        margin-left: 14px;
      }

      .project-context {
        color: var(--active-primary);
        font-size: 9.5px;
        font-weight: 600;
        letter-spacing: 0.075em;
        text-transform: uppercase;
      }

      .project-card strong {
        margin-top: 6px;
        font-size: clamp(16px, 1.6vw, 21px);
        font-weight: 500;
        line-height: 1.25;
      }

      .project-summary {
        margin-top: 9px;
        color: #5b5751;
        font-size: 12.5px;
        line-height: 1.55;
      }

      .project-open {
        margin-top: auto;
        padding-top: 16px;
        color: var(--active-primary);
        font-size: 10.5px;
      }

      /* The certificate shelf. A certificate is a sheet of paper, so each one is
         shown whole on a pale mount rather than cropped to a tile. */
      .certificate-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(18px, 2.6vw, 34px);
        margin-top: 32px;
      }

      .certificate-card {
        display: flex;
        min-width: 0;
        padding: 0 0 16px;
        flex-direction: column;
        border: 1px solid color-mix(in srgb, var(--active-primary) 26%, transparent);
        background: color-mix(in srgb, var(--paper) 92%, var(--active-secondary));
        color: var(--ink);
        text-decoration: none;
        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease,
          transform 0.2s ease;
      }

      .certificate-card:hover,
      .certificate-card:focus-visible {
        border-color: var(--active-primary);
        box-shadow: 0 12px 28px rgba(41, 40, 37, 0.1);
        outline: none;
        transform: translateY(-2px);
      }

      .certificate-sheet {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: clamp(14px, 1.8vw, 24px);
        margin-bottom: 12px;
        background:
          linear-gradient(150deg, color-mix(in srgb, var(--active-secondary) 26%, var(--paper)), var(--paper) 74%);
        border-bottom: 1px solid color-mix(in srgb, var(--active-primary) 18%, transparent);
      }

      .certificate-sheet :global(img) {
        width: 100%;
        height: auto;
        box-shadow: 0 6px 20px rgba(41, 40, 37, 0.14);
      }

      .certificate-card .project-context,
      .certificate-card strong,
      .certificate-note,
      .certificate-card .project-open {
        margin-right: 16px;
        margin-left: 16px;
      }

      .certificate-card strong {
        margin-top: 6px;
        font-size: clamp(18px, 1.8vw, 24px);
        font-weight: 500;
        line-height: 1.2;
      }

      .certificate-note {
        margin-top: 9px;
        color: #5b5751;
        font-size: 12.5px;
        line-height: 1.6;
      }

      .certificate-footnote {
        margin: 26px 0 0;
        color: #6d6862;
        font-size: 11.5px;
      }

      /* The window's photographs. Columns rather than a grid, so every frame
         keeps the proportions it was taken at. */
      .gallery-columns {
        margin-top: 32px;
        columns: 280px;
        column-gap: clamp(12px, 1.6vw, 22px);
      }

      .gallery-photo {
        display: block;
        margin-bottom: clamp(12px, 1.6vw, 22px);
        break-inside: avoid;
        border: 1px solid color-mix(in srgb, var(--active-primary) 22%, transparent);
        line-height: 0;
        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease,
          transform 0.2s ease;
      }

      .gallery-photo :global(img) {
        width: 100%;
        height: auto;
      }

      .gallery-photo:hover,
      .gallery-photo:focus-visible {
        border-color: var(--active-primary);
        box-shadow: 0 10px 26px rgba(41, 40, 37, 0.14);
        outline: none;
        transform: translateY(-2px);
      }

      .gallery-lightbox {
        position: fixed;
        z-index: 7;
        inset: 0;
        display: grid;
        place-items: center;
        padding: clamp(48px, 7vw, 92px);
        background: rgba(35, 36, 34, 0.82);
        backdrop-filter: blur(14px);
      }

      .gallery-lightbox[hidden] {
        display: none;
      }

      .gallery-lightbox > button {
        position: fixed;
        z-index: 1;
        top: 18px;
        right: 22px;
        padding: 8px 15px;
        border: 1px solid rgba(255, 255, 255, 0.42);
        border-radius: 999px;
        background: rgba(35, 36, 34, 0.72);
        color: white;
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }

      .gallery-lightbox figure {
        display: grid;
        place-items: center;
        max-width: min(1500px, 100%);
        max-height: 100%;
        margin: 0;
      }

      .gallery-lightbox img {
        display: block;
        width: auto;
        max-width: 100%;
        height: auto;
        max-height: calc(100svh - clamp(96px, 14vw, 184px));
        box-shadow: 0 28px 80px rgba(0, 0, 0, 0.28);
      }

      .project-reader article {
        max-width: 1180px;
        margin: 0 auto;
        padding: 6px 0 24px;
        animation: reader-enter 0.46s ease both;
      }

      @keyframes reader-enter {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
      }

      :global(::view-transition-group(project-frame)),
      :global(::view-transition-group(project-media)),
      :global(::view-transition-group(project-title)),
      :global(::view-transition-group(gallery-photo)) {
        animation-duration: 0.58s;
        animation-timing-function: cubic-bezier(0.22, 0.72, 0.18, 1);
      }

      :global(::view-transition-old(root)),
      :global(::view-transition-new(root)) {
        animation-duration: 0.24s;
      }

      .project-reader h2 {
        max-width: 980px;
        margin-top: 8px;
        font-size: clamp(42px, 6vw, 76px);
        line-height: 1.04;
      }

      .project-reader h2:focus {
        outline: none;
      }

      .project-role {
        max-width: 780px;
        margin: 18px 0 26px;
        padding: 13px 15px;
        border-left: 3px solid var(--active-primary);
        background: color-mix(in srgb, var(--active-secondary) 12%, var(--paper));
        color: #4f4b46;
        font-size: 12px;
        line-height: 1.65;
      }

      .project-reader :global(.project-hero) {
        width: 100%;
        max-width: 1180px;
        margin: 26px 0 32px;
      }

      .project-reader :global(.project-hero img) {
        display: block;
        width: 100%;
        height: auto;
        margin: 0;
        border: 1px solid color-mix(in srgb, var(--active-primary) 18%, transparent);
        background: #ece8df;
      }

      .project-reader :global(.project-hero figcaption) {
        margin-top: 9px;
        color: #625d57;
        font-size: 11.5px;
        line-height: 1.55;
      }

      .project-content {
        color: #3f3c38;
        font-size: 15px;
        line-height: 1.8;
      }

      .project-content > :global(p),
      .project-content > :global(ul),
      .project-content > :global(h2) {
        max-width: 780px;
      }

      .project-content :global(h2) {
        margin: 56px 0 14px;
        font-size: clamp(26px, 3vw, 38px);
        line-height: 1.2;
      }

      .project-content :global(p),
      .project-content :global(ul) {
        margin: 14px 0;
      }

      .project-content :global(img) {
        display: block;
        width: 100%;
        height: auto;
        max-height: 760px;
        margin: 18px 0 7px;
        border: 1px solid color-mix(in srgb, var(--active-primary) 18%, transparent);
        object-fit: contain;
        background: #ece8df;
      }

      .project-content :global(em) {
        color: #625d57;
        font-size: 11.5px;
      }

      .project-content :global(.media-gallery) {
        display: grid;
        gap: clamp(18px, 2.5vw, 32px);
        width: 100%;
        max-width: 1180px;
        margin: 28px 0 48px;
      }

      .project-content :global(.media-gallery figure) {
        min-width: 0;
        margin: 0;
      }

      .project-content :global(.media-gallery img) {
        width: 100%;
        height: auto;
        max-height: none;
        margin: 0;
        object-fit: contain;
      }

      .project-content :global(.media-gallery figcaption) {
        margin-top: 9px;
        color: #625d57;
        font-size: 11.5px;
        line-height: 1.55;
      }

      .project-content :global(.media-gallery.testing) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .project-content :global(.media-gallery.testing figure:nth-child(1)) {
        grid-column: 1;
        grid-row: 1;
      }

      .project-content :global(.media-gallery.testing figure:nth-child(2)) {
        grid-column: 1 / -1;
        grid-row: 2;
      }

      .project-content :global(.media-gallery.testing figure:nth-child(3)) {
        grid-column: 2;
        grid-row: 1;
      }

      .project-content :global(.media-gallery.prototype) {
        grid-template-columns: minmax(280px, 0.78fr) minmax(0, 1.22fr);
        align-items: start;
      }

      .project-content :global(.media-gallery.prototype figure:first-child) {
        grid-row: 1 / 3;
      }

      .project-content :global(.media-gallery.result) {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        align-items: center;
      }

      .project-content :global(.media-gallery.result figure:first-child) {
        grid-column: 1 / 6;
      }

      .project-content :global(.media-gallery.result figure:last-child) {
        grid-column: 6 / -1;
      }

      .project-content :global(.media-gallery.lesson) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: start;
      }

      .project-content :global(.media-gallery.football) {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        align-items: start;
      }

      .project-content :global(.media-gallery.football figure:first-child) {
        grid-column: 1 / -1;
      }

      .project-content :global(.media-gallery.football figure:last-child) {
        grid-column: 3 / 11;
      }

      .hover {
        left: 50%;
        bottom: clamp(20px, 4vh, 42px);
        margin: 0;
        color: var(--ink);
        font-size: 11.5px;
        letter-spacing: 0.02em;
        opacity: 0;
        transform: translateX(-50%);
        transition: opacity 0.2s ease;
        pointer-events: none;
      }

      .hover.on {
        opacity: 1;
      }

