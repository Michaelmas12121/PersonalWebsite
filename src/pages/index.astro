---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import "../styles/global.css";
import cyclingRoute from "../assets/continue/cycling/shenzhen-bay-route.webp";
import metabolisCover from "../assets/continue/metabolis/background-title-source.png";
import galleryOne from "../assets/gallery/gallery-01.webp";
import galleryTwo from "../assets/gallery/gallery-06.webp";
import galleryThree from "../assets/gallery/gallery-09.webp";
import galleryFour from "../assets/gallery/gallery-12.webp";
import galleryFive from "../assets/gallery/gallery-15.webp";
import gallerySix from "../assets/gallery/gallery-20.webp";
import elderGoTesting from "../content/activities/eldercare-robot/testing-debugging.webp";
import turingClassroom from "../content/activities/turing-society/classroom-session.jpg";
import footballHuddle from "../content/activities/football/team-huddle.webp";
import aimeCertificate from "../assets/certificates/v4/aime-2026.webp";
import himcmCertificate from "../assets/certificates/v4/himcm-2025-redacted.webp";
import immcFinalistCertificate from "../assets/certificates/v4/immc-finalist-2026-redacted.webp";
import immcOutstandingCertificate from "../assets/certificates/v4/immc-outstanding-2026-redacted.webp";

const activities = (await getCollection("activities")).sort(
  (left, right) => left.data.order - right.data.order,
);

const supportingImages = new Map([
  ["eldercare-robot", { src: elderGoTesting, alt: "The ElderGo prototype being checked during testing" }],
  ["turing-society", { src: turingClassroom, alt: "A Turing Society mathematics lesson at the classroom board" }],
  ["football", { src: footballHuddle, alt: "The school football team links arms before play" }],
]);

const achievements = [
  { award: "Outstanding", context: "IMMC · 2026" },
  { award: "Finalist", context: "IMMC · 2026" },
  { award: "Meritorious", context: "HiMCM · 2025" },
  { award: "AIME II qualifier", context: "AIME · 2026" },
];

const gallery = [galleryOne, galleryTwo, galleryThree, galleryFour, galleryFive, gallerySix];
const certificates = [immcOutstandingCertificate, immcFinalistCertificate, himcmCertificate, aimeCertificate];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Yanlang Liu — mathematics, artificial intelligence, research, and teaching." />
    <title>Yanlang Liu</title>
  </head>

  <body>
    <div class="cursor-glow" aria-hidden="true"></div>
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Back to the top">YL</a>
      <nav aria-label="Primary navigation">
        <a href="#work">Work</a>
        <a href="#highlights">Highlights</a>
        <a href="#room">Interactive room</a>
      </nav>
      <a class="room-link" href="/interactive">Explore <span aria-hidden="true">↗</span></a>
    </header>

    <main id="top">
      <section class="hero page-width" aria-labelledby="hero-title">
        <div class="hero-main">
          <p class="eyebrow">Student portfolio · Shenzhen, China</p>
          <h1 id="hero-title">Yanlang<br />Liu</h1>
          <p class="hero-statement">Mathematics and artificial intelligence, explored through building, teaching, and working with others.</p>
        </div>
        <div class="about-card">
          <p class="eyebrow">About · 17 years old</p>
          <h2>Learning how systems connect.</h2>
          <p>I study at Shenzhen Middle School. I enjoy taking a difficult idea apart, finding the structure underneath it, and making it understandable to someone else.</p>
          <p class="about-meta">Mathematics · AI · Research · Education</p>
        </div>
      </section>

      <section class="work page-width" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 · Selected work</p>
            <h2 id="work-title">Learning by doing.</h2>
          </div>
          <p>Three roles, shown directly: building, teaching, and teamwork.</p>
        </div>

        <div class="work-grid">
          {
            activities.map((activity) => {
              const supportingImage = supportingImages.get(activity.id);
              return (
                <article class="work-card">
                  <div class="work-images">
                    {activity.data.cover && (
                      <Image src={activity.data.cover} alt={activity.data.coverAlt ?? ""} widths={[260, 420, 560]} sizes="(max-width: 760px) 72vw, 25vw" loading="eager" />
                    )}
                    {supportingImage && (
                      <Image src={supportingImage.src} alt={supportingImage.alt} widths={[180, 280, 360]} sizes="(max-width: 760px) 28vw, 10vw" loading="lazy" />
                    )}
                  </div>
                  <div class="work-copy">
                    <p class="eyebrow">{activity.data.category}</p>
                    <h3>{activity.data.title}</h3>
                    <p class="work-context">{activity.data.context}</p>
                    <p class="work-summary">{activity.data.summary}</p>
                    {activity.data.role && <p class="work-role"><strong>My role:</strong> {activity.data.role}</p>}
                  </div>
                </article>
              );
            })
          }
        </div>
      </section>

      <section class="highlights page-width" id="highlights" aria-labelledby="highlights-title">
        <div class="achievement-panel">
          <p class="eyebrow">02 · Highlights</p>
          <h2 id="highlights-title">Mathematical modelling.</h2>
          <ol class="achievement-list">
            {achievements.map((achievement, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{achievement.award}</strong>
                <small>{achievement.context}</small>
              </li>
            ))}
          </ol>
          <div class="certificate-grid" aria-label="Award certificates">
            {certificates.map((certificate) => (
              <Image src={certificate} alt="" widths={[140, 220]} sizes="(max-width: 680px) 21vw, 8vw" loading="lazy" />
            ))}
          </div>
        </div>

        <div class="current-panel">
          <div class="panel-title"><p class="eyebrow">03 · Building now</p><span>Work in progress</span></div>
          <div class="current-grid">
            <article>
              <Image src={metabolisCover} alt="Pixel-art roads and vehicles from Metabolis" widths={[260, 420]} sizes="(max-width: 760px) 50vw, 18vw" loading="lazy" />
              <div><strong>Metabolis</strong><span>Biology as a strategy game</span></div>
            </article>
            <article>
              <Image src={cyclingRoute} alt="A privacy-cropped cycling route through Shenzhen" widths={[260, 420]} sizes="(max-width: 760px) 50vw, 18vw" loading="lazy" />
              <div><strong>327.3 km</strong><span>17 rides through Shenzhen</span></div>
            </article>
          </div>
        </div>

        <div class="gallery-panel">
          <div class="panel-title"><p class="eyebrow">04 · A few frames</p><span>More in the room</span></div>
          <div class="photo-grid">
            {gallery.map((photo) => (
              <Image src={photo} alt="" widths={[160, 240]} sizes="(max-width: 760px) 30vw, 10vw" loading="lazy" />
            ))}
          </div>
        </div>
      </section>

      <section class="room-invitation" id="room" aria-labelledby="room-title">
        <a class="room-entry page-width" href="/interactive">
          <div class="room-copy">
            <p class="eyebrow">Optional creative version · Allow a little time to explore</p>
            <h2 id="room-title">Enter my<br />interactive room.</h2>
            <p>The same portfolio becomes a personal space: move between the desk, the projects, the certificates, and the window.</p>
            <span class="room-button">Open the room <span aria-hidden="true">↗</span></span>
          </div>
          <div class="door-scene" aria-hidden="true">
            <span class="door-label">A different way in</span>
            <div class="door-frame">
              <div class="door-opening"><span>Explore</span></div>
              <div class="door-panel">
                <span class="door-number">YL · 17</span>
                <i class="door-inset door-inset-top"></i>
                <i class="door-inset door-inset-bottom"></i>
                <i class="door-handle"></i>
              </div>
            </div>
            <span class="door-floor-line"></span>
          </div>
        </a>
      </section>
    </main>

    <footer class="site-footer page-width">
      <p>Yanlang Liu · Shenzhen, China</p>
      <a href="#top">Back to top ↑</a>
    </footer>

    <script>
      const supportsFinePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (supportsFinePointer.matches && !prefersReducedMotion.matches) {
        document.body.classList.add("has-pointer-glow");
        window.addEventListener("pointermove", (event) => {
          document.documentElement.style.setProperty("--pointer-x", `${event.clientX}px`);
          document.documentElement.style.setProperty("--pointer-y", `${event.clientY}px`);
        }, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { --display-font: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; --meta-font: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace; background: #faf6f1; }
  .cursor-glow { position: fixed; z-index: 0; inset: 0; pointer-events: none; opacity: 0; background: radial-gradient(380px circle at var(--pointer-x, 50vw) var(--pointer-y, -20vh), rgb(200 85 47 / 9%), transparent 70%); transition: opacity 280ms ease; }
  :global(body.has-pointer-glow) .cursor-glow { opacity: 1; }
  :global(body) > :not(.cursor-glow) { position: relative; z-index: 1; }
  .page-width { width: min(1240px, calc(100% - 44px)); margin: 0 auto; }
  .site-header { position: sticky; z-index: 10; top: 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; width: min(1300px, calc(100% - 36px)); min-height: 48px; margin: 0 auto; border-bottom: 1px solid #e8e0d6; background: color-mix(in srgb, #faf6f1 94%, transparent); backdrop-filter: blur(14px); }
  .wordmark { width: max-content; font-size: .84rem; font-weight: 800; letter-spacing: -.07em; }
  nav { display: flex; gap: 22px; font-size: .68rem; }
  nav a, .room-link, .site-footer a { transition: color 180ms ease; }
  nav a:hover, .room-link:hover, .site-footer a:hover { color: #c8552f; }
  .room-link { justify-self: end; font-size: .7rem; font-weight: 700; }
  .eyebrow { margin: 0; color: #8a817a; font-family: var(--meta-font); font-size: .58rem; font-weight: 700; letter-spacing: .08em; line-height: 1.4; text-transform: uppercase; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2, h3 { letter-spacing: -.055em; }
  h1, h2 { font-family: var(--display-font); }
  h1 { margin: 8px 0 10px; color: #131211; font-size: clamp(4.8rem, 9.2vw, 8.5rem); font-weight: 700; letter-spacing: -.08em; line-height: .7; text-shadow: .04em .04em 0 #e7c9b6, .08em .08em 0 rgb(213 168 74 / 38%); }
  h2 { margin-bottom: 0; font-size: clamp(2rem, 3.5vw, 3.2rem); font-weight: 700; line-height: .86; }
  h3 { margin: 5px 0 4px; font-size: clamp(1.12rem, 1.55vw, 1.5rem); line-height: .98; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.38fr) minmax(300px, .62fr); gap: clamp(30px, 5vw, 76px); align-items: end; min-height: 34svh; padding: 25px 0 20px; }
  .hero-main { position: relative; }
  .hero-main::after { position: absolute; z-index: -1; right: 8%; bottom: 8%; width: clamp(130px, 15vw, 210px); aspect-ratio: 1.45; content: ""; background: linear-gradient(135deg, rgb(213 168 74 / 28%), rgb(200 85 47 / 12%)); transform: rotate(-5deg); }
  .hero-statement { max-width: 620px; margin: 0; color: #554f49; font-size: clamp(.84rem, 1.25vw, 1.04rem); line-height: 1.42; }
  .about-card { padding: 0 0 4px 22px; border-left: 1px solid #d8cec3; }
  .about-card h2 { max-width: 450px; margin: 9px 0 11px; font-size: clamp(1.8rem, 3vw, 2.8rem); }
  .about-card > p:not(.eyebrow, .about-meta) { max-width: 500px; margin-bottom: 11px; color: #554f49; font-size: .78rem; line-height: 1.48; }
  .about-meta { margin-bottom: 0; color: #8a817a; font-family: var(--meta-font); font-size: .58rem; }
  .work { padding: 17px 0 20px; border-top: 1px solid #e8e0d6; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  .section-heading h2 { margin-top: 5px; font-size: clamp(1.75rem, 3vw, 2.75rem); }
  .section-heading > p { max-width: 260px; margin: 0; color: #8a817a; font-size: .68rem; line-height: 1.4; text-align: right; }
  .work-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 14px; }
  .work-card { min-width: 0; border: 1px solid #ded5cb; background: rgb(255 253 250 / 72%); overflow: hidden; transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease; }
  .work-images { display: grid; grid-template-columns: 1.6fr .7fr; gap: 3px; height: clamp(138px, 19svh, 200px); background: #e9e1d8; overflow: hidden; }
  .work-images :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 420ms cubic-bezier(.2, .65, .2, 1), filter 220ms ease; }
  .work-images :global(img:nth-child(2)) { filter: saturate(.82); }
  .work-copy { padding: 11px 12px 12px; }
  .work-context { margin-bottom: 6px; color: #8a817a; font-family: var(--meta-font); font-size: .56rem; line-height: 1.35; }
  .work-summary { margin: 7px 0 6px; font-size: .69rem; line-height: 1.38; }
  .work-role { margin-bottom: 0; color: #665e57; font-size: .61rem; line-height: 1.35; }
  .highlights { display: grid; grid-template-columns: 1.02fr 1.02fr .96fr; gap: 10px; min-height: 48svh; padding: 18px 0 20px; border-top: 1px solid #e8e0d6; }
  .achievement-panel, .current-panel, .gallery-panel { min-width: 0; padding: 15px; border: 1px solid #ded5cb; background: rgb(255 253 250 / 70%); }
  .achievement-panel h2 { margin: 7px 0 12px; font-size: clamp(1.65rem, 2.45vw, 2.35rem); }
  .achievement-list { padding: 0; margin: 0; list-style: none; }
  .achievement-list li { display: grid; grid-template-columns: 27px minmax(0, 1fr) auto; gap: 7px; align-items: baseline; padding: 6px 0; border-top: 1px solid #e8e0d6; }
  .achievement-list span { color: #c8552f; font-family: var(--meta-font); font-size: .55rem; }
  .achievement-list strong { font-size: .68rem; }
  .achievement-list small { color: #8a817a; font-family: var(--meta-font); font-size: .52rem; }
  .certificate-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; margin-top: 11px; }
  .certificate-grid :global(img) { display: block; width: 100%; height: 76px; border: 1px solid #e8e0d6; object-fit: cover; object-position: top; filter: saturate(.78); transition: filter 200ms ease, transform 260ms ease; }
  .panel-title { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
  .panel-title > span { color: #9b9188; font-family: var(--meta-font); font-size: .5rem; text-transform: uppercase; }
  .current-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; height: calc(100% - 24px); }
  .current-grid article { display: grid; grid-template-rows: minmax(0, 1fr) auto; min-width: 0; border: 1px solid #e8e0d6; overflow: hidden; }
  .current-grid :global(img) { width: 100%; height: 100%; min-height: 0; object-fit: cover; transition: transform 360ms ease; }
  .current-grid article > div { display: grid; gap: 2px; padding: 7px; background: #faf6f1; }
  .current-grid strong { font-size: .66rem; }
  .current-grid span { color: #8a817a; font-size: .53rem; line-height: 1.3; }
  .photo-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 4px; height: calc(100% - 24px); }
  .photo-grid :global(img) { width: 100%; height: 100%; min-height: 0; aspect-ratio: 1; object-fit: cover; transition: filter 200ms ease, transform 300ms ease; }
  .room-invitation { min-height: 50svh; border-top: 1px solid #342f2b; background: #171615; color: #faf6f1; overflow: hidden; }
  .room-entry { display: grid; grid-template-columns: minmax(270px, .68fr) minmax(420px, 1.32fr); gap: clamp(34px, 7vw, 100px); align-items: center; min-height: 50svh; padding-top: 24px; padding-bottom: 24px; color: inherit; }
  .room-entry:focus-visible { outline: 2px solid #d5a84a; outline-offset: -2px; }
  .room-copy .eyebrow { color: #c3b8ae; }
  .room-copy h2 { margin: 9px 0 12px; font-size: clamp(2.8rem, 5.4vw, 5.5rem); line-height: .78; text-shadow: .04em .04em 0 #6d3e30, .08em .08em 0 rgb(213 168 74 / 40%); }
  .room-copy > p:not(.eyebrow) { max-width: 440px; margin-bottom: 16px; color: #cfc5bb; font-size: .72rem; line-height: 1.48; }
  .room-button { display: inline-flex; gap: 12px; align-items: center; padding: 9px 12px; border: 1px solid #faf6f1; font-size: .67rem; font-weight: 700; transition: background 180ms ease, color 180ms ease; }
  .door-scene { position: relative; height: min(37svh, 350px); border: 1px solid #5f5953; background: radial-gradient(circle at 58% 45%, rgb(213 168 74 / 9%), transparent 33%), linear-gradient(150deg, #211f1d, #131211); box-shadow: 18px 18px 0 rgb(200 85 47 / 13%); perspective: 1000px; transition: border-color 240ms ease, transform 340ms cubic-bezier(.2, .65, .2, 1); }
  .door-label { position: absolute; top: 9%; left: 7%; color: #918980; font-family: var(--meta-font); font-size: .5rem; letter-spacing: .1em; text-transform: uppercase; writing-mode: vertical-rl; }
  .door-frame { position: absolute; top: 7%; bottom: 8%; left: 50%; width: min(36%, 220px); border: 3px solid #9c9186; border-bottom-width: 5px; box-shadow: 0 0 0 1px #302d2a, 0 0 34px rgb(213 168 74 / 6%); transform: translateX(-50%); perspective: 900px; }
  .door-opening { position: absolute; inset: 0; display: grid; place-items: center; background: linear-gradient(145deg, #d5a84a 0%, #b97865 36%, #3f526b 100%); overflow: hidden; }
  .door-opening::before { position: absolute; inset: 0; content: ""; background: linear-gradient(115deg, transparent 18%, rgb(250 246 241 / 28%) 49%, transparent 68%); transform: translateX(-80%); transition: transform 650ms ease; }
  .door-opening span { color: rgb(250 246 241 / 88%); font-family: var(--display-font); font-size: clamp(1.25rem, 2vw, 2rem); letter-spacing: -.04em; text-shadow: 0 2px 14px rgb(23 22 21 / 38%); }
  .door-panel { position: absolute; inset: 0; border: 1px solid #aea298; background: linear-gradient(115deg, #262320, #171615 65%); box-shadow: inset -14px 0 28px rgb(0 0 0 / 26%); transform: rotateY(0deg); transform-origin: left center; transform-style: preserve-3d; transition: transform 620ms cubic-bezier(.2, .72, .2, 1), box-shadow 400ms ease; }
  .door-number { position: absolute; top: 6%; left: 8%; color: #b7ada4; font-family: var(--meta-font); font-size: .48rem; letter-spacing: .12em; }
  .door-inset { position: absolute; right: 13%; left: 13%; display: block; border: 1px solid #5f5953; box-shadow: inset 0 0 0 5px #1b1917; }
  .door-inset-top { top: 18%; height: 28%; }
  .door-inset-bottom { bottom: 10%; height: 32%; }
  .door-handle { position: absolute; top: 52%; right: 9%; width: 8px; aspect-ratio: 1; border: 2px solid #d5a84a; border-radius: 50%; box-shadow: 0 0 0 4px rgb(213 168 74 / 10%); }
  .door-handle::after { position: absolute; top: 2px; left: 7px; width: 19px; height: 2px; content: ""; background: #d5a84a; transform: rotate(-8deg); transform-origin: left; }
  .door-floor-line { position: absolute; right: 7%; bottom: 7%; left: 7%; height: 1px; background: #5f5953; transform: rotate(-3deg); transform-origin: right; }
  .site-footer { display: flex; justify-content: space-between; gap: 24px; padding: 12px 0 14px; border-top: 1px solid #e8e0d6; color: #8a817a; font-family: var(--meta-font); font-size: .56rem; }
  .site-footer p { margin-bottom: 0; }
  @media (hover: hover) and (pointer: fine) {
    nav a { position: relative; }
    nav a::after { position: absolute; right: 0; bottom: -7px; left: 0; height: 1px; content: ""; background: currentcolor; transform: scaleX(0); transform-origin: right; transition: transform 180ms ease; }
    nav a:hover::after { transform: scaleX(1); transform-origin: left; }
    .work-card:hover { z-index: 1; border-color: #c8552f; box-shadow: 0 12px 26px rgb(56 42 31 / 10%); transform: translateY(-4px); }
    .work-card:hover .work-images :global(img:first-child), .current-grid article:hover :global(img) { transform: scale(1.035); }
    .work-card:hover .work-images :global(img:nth-child(2)) { filter: saturate(1); transform: scale(1.06); }
    .photo-grid :global(img):hover { z-index: 1; filter: saturate(1.12); transform: scale(1.08) rotate(-1deg); }
    .certificate-grid :global(img):hover { z-index: 1; filter: saturate(1); transform: translateY(-3px) scale(1.06); }
    .room-entry:hover .room-button { background: #faf6f1; color: #171615; }
    .room-entry:hover .door-scene { border-color: #d5a84a; transform: translate(-7px, -5px) rotate(-.5deg); }
    .room-entry:hover .door-panel { box-shadow: 18px 0 35px rgb(0 0 0 / 34%); transform: rotateY(-28deg); }
    .room-entry:hover .door-opening::before { transform: translateX(85%); }
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1.1fr .9fr; min-height: auto; padding: 30px 0; }
    .work-grid { grid-template-columns: 1fr 1fr; }
    .work-card:last-child { grid-column: 1 / -1; }
    .highlights { grid-template-columns: 1fr 1fr; min-height: auto; }
    .gallery-panel { grid-column: 1 / -1; }
    .photo-grid { height: 170px; grid-template-columns: repeat(6, 1fr); grid-template-rows: 1fr; }
  }
  @media (max-width: 680px) {
    .page-width { width: min(100% - 28px, 540px); }
    .site-header { grid-template-columns: 1fr auto; width: min(100% - 24px, 570px); min-height: 46px; }
    .site-header nav { display: none; }
    .hero { grid-template-columns: 1fr; gap: 25px; padding: 25px 0 22px; }
    h1 { font-size: clamp(4.5rem, 22vw, 6.2rem); }
    .about-card { padding-left: 14px; }
    .work { padding-top: 15px; }
    .section-heading { align-items: start; }
    .section-heading > p { max-width: 145px; font-size: .58rem; }
    .work-grid { grid-template-columns: 1fr; }
    .work-card:last-child { grid-column: auto; }
    .work-images { height: 180px; }
    .highlights { grid-template-columns: 1fr; padding-top: 14px; }
    .gallery-panel { grid-column: auto; }
    .photo-grid { grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(2, 90px); height: auto; }
    .room-entry { grid-template-columns: 1fr; gap: 24px; min-height: auto; padding-top: 34px; padding-bottom: 38px; }
    .room-copy h2 { font-size: clamp(3rem, 15vw, 4.4rem); }
    .door-scene { order: -1; height: 230px; }
