---
import "../styles/global.css";
import "../v4/portfolio.css";
import PageMotion from "../v4/PageMotion.astro";
import PortfolioNav from "../v4/PortfolioNav.astro";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Yanlang Liu — projects, activities, photography, cycling, game development, and honors." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/anton.woff" as="font" type="font/woff" crossorigin />
    <PageMotion />
    <title>Yanlang Liu</title>
  </head>
  <body>
    <main class="portfolio-home">
      <svg class="contours" viewBox="0 0 1680 950" preserveAspectRatio="none" fill="none" aria-hidden="true">
        <g stroke="currentColor" stroke-width="1">
          <path d="M270 -40C290 190 380 200 560 335S720 510 855 470 1000 350 1115 422 1460 520 1740 255" />
          <path d="M435 -40C470 180 570 255 725 267S1030 65 1120 -30" />
          <path d="M1320 -30C1170 170 1200 360 1390 365S1580 310 1740 205" />
          <path d="M1490 -30C1340 135 1390 240 1570 232S1690 200 1730 145" />
          <path d="M-50 190C160 290 155 450 40 548S60 787 255 760 565 510 624 645 720 900 440 1000" />
          <path d="M-60 300C90 325 55 435 -30 491" />
          <path d="M-30 583C125 470 215 615 425 574S535 650 355 702 40 642 -30 761" />
          <path d="M-30 830C125 868 245 933 290 980" />
          <path d="M1035 606C1120 650 1160 816 1055 916S1160 985 1260 861 1350 700 1510 654 1660 560 1730 565" />
        </g>
      </svg>
      <h1 class="name">YANLANG LIU</h1>
      <PortfolioNav home />
      <a class="room-door" href="/interactive/" data-astro-prefetch="hover" aria-label="Enter my interactive room">
        <svg viewBox="0 0 80 130" fill="none" aria-hidden="true">
          <path d="M12 118V20H44" />
          <g class="door-leaf"><path d="M44 20L69 11V124L44 116Z" /><path d="M44 70H50" /></g>
        </svg>
        <span class="door-label" aria-hidden="true">INTERACTIVE ROOM</span>
      </a>
    </main>
  </body>
</html>
<style>
  :global(html), :global(body) { margin: 0; overflow: hidden; }
  .portfolio-home { position: relative; width: 100%; height: 100svh; min-height: 0; overflow: hidden; isolation: isolate; }
  .contours { transform: translate(var(--pointer-x, 0px), var(--pointer-y, 0px)) scale(1.025); transition: transform 700ms ease-out; position: absolute; inset: 0; width: 100%; height: 100%; color: #dcd5c6; z-index: -1; pointer-events: none; }
  .name { position: absolute; top: 50%; left: 50%; width: max-content; margin: 0; color: #e2ded2; font: 400 22vw/.95 "Anton", Impact, sans-serif; letter-spacing: -.025em; text-align: center; white-space: nowrap; transform: translate(-50%, -50%); z-index: -2; pointer-events: none; }
  .room-door { position: absolute; z-index: 4; bottom: 2.5%; left: 50%; transform: translateX(-50%); width: clamp(44px, 7svh, 70px); color: #35352f; }
  .room-door svg { display: block; width: 100%; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .door-label { position: absolute; left: calc(100% + 12px); top: 50%; white-space: nowrap; font-size: clamp(9px, 1vw, 12px); letter-spacing: .12em; opacity: 0; transform: translate(-4px, -50%); transition: opacity 200ms ease, transform 200ms ease; pointer-events: none; }
  .room-door:hover .door-label, .room-door:focus-visible .door-label { opacity: 1; transform: translate(0, -50%); }
  .room-door:focus-visible { outline: 1px solid currentColor; outline-offset: 6px; }
  .door-leaf { transform-origin: 44px 70px; transition: transform 300ms ease; }
  .room-door:hover .door-leaf, .room-door:focus-visible .door-leaf { transform: skewY(-5deg) scaleX(.78); }
  @media (max-width: 700px) and (orientation: portrait) {
    .room-door { bottom: 2%; width: 44px; padding: 3px; }
  }
  @media (max-height: 500px) and (orientation: landscape) {
    .room-door { width: 32px; bottom: 2%; }
  }
  @media (prefers-reduced-motion: reduce) { .door-label { transition: none; } }
</style>
