---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import "../styles/global.css";
import cyclingRoute from "../assets/continue/cycling/shenzhen-bay-route.webp";
import metabolisCover from "../assets/continue/metabolis/background-title-source.png";
import galleryOne from "../assets/gallery/gallery-01.webp";
import galleryTwo from "../assets/gallery/gallery-06.webp";
import galleryThree from "../assets/gallery/gallery-12.webp";
import galleryFour from "../assets/gallery/gallery-20.webp";

const activities = (await getCollection("activities")).sort(
  (left, right) => left.data.order - right.data.order,
);

const achievements = [
  { award: "Outstanding", context: "International Mathematical Modeling Challenge · 2026" },
  { award: "Finalist", context: "International Mathematical Modeling Challenge · 2026" },
  { award: "Meritorious", context: "High School Mathematical Contest in Modeling · 2025" },
  { award: "AIME II qualifier", context: "American Invitational Mathematics Examination · 2026" },
];

const gallery = [galleryOne, galleryTwo, galleryThree, galleryFour];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="description"
      content="Yanlang Liu — mathematics, artificial intelligence, research, and teaching."
    />
    <title>Yanlang Liu</title>
  </head>

  <body>
    <div class="cursor-glow" aria-hidden="true"></div>
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Back to the top">YL</a>
      <nav aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a href="#achievements">Achievements</a>
        <a href="#now">Now</a>
      </nav>
      <a class="room-link compact-room-link" href="/interactive">Interactive room <span aria-hidden="true">↗</span></a>
    </header>

    <main id="top">
      <section class="hero page-width" aria-labelledby="hero-title">
        <p class="eyebrow">Student portfolio · Shenzhen, China</p>
        <div class="hero-copy">
          <h1 id="hero-title">Yanlang Liu</h1>
          <p class="hero-statement">
            I study mathematics and artificial intelligence through building, teaching, and working with others.
          </p>
        </div>
        <div class="hero-details">
          <p>International Division<br />Shenzhen Middle School</p>
          <p>Mathematics · AI · Research · Education</p>
        </div>
        <div class="hero-actions">
          <a class="button primary" href="#work">View selected work <span aria-hidden="true">↓</span></a>
          <a class="button secondary" href="/interactive">Explore the interactive room <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="about section page-width" id="about" aria-labelledby="about-title">
        <p class="eyebrow">01 · About</p>
        <div class="section-intro">
          <h2 id="about-title">Learning how systems connect.</h2>
          <p>
            I am a seventeen-year-old student at Shenzhen Middle School. My work moves between mathematical ideas, artificial intelligence, and the practical questions that appear when people have to use what you build. I enjoy taking a difficult idea apart, finding the structure underneath it, and making it understandable to someone else.
          </p>
        </div>
      </section>

      <section class="work section page-width" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">02 · Selected work</p>
            <h2 id="work-title">A few ways I learn by doing.</h2>
          </div>
          <p class="section-note">Each entry gives the key context without opening another page. Longer records remain available in the interactive room.</p>
        </div>

        <div class="work-list">
          {
            activities.map((activity) => (
              <article class="work-item">
                <div class="work-image">
                  {activity.data.cover && (
                    <Image
                      src={activity.data.cover}
                      alt={activity.data.coverAlt ?? ""}
                      widths={[320, 480]}
                      sizes="(max-width: 720px) 100vw, 30vw"
                      loading="lazy"
                    />
                  )}
                </div>
                <div class="work-copy">
                  <p class="eyebrow">{activity.data.category}</p>
                  <h3>{activity.data.title}</h3>
                  <p class="work-context">{activity.data.context}</p>
                  <p class="work-summary">{activity.data.summary}</p>
                  {activity.data.role && <p class="work-role"><strong>My role:</strong> {activity.data.role}</p>}
                  <ul class="tag-list" aria-label={`${activity.data.title} topics`}>
                    {activity.data.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="achievements section page-width" id="achievements" aria-labelledby="achievements-title">
        <div class="section-heading compact-heading">
          <div>
            <p class="eyebrow">03 · Achievements</p>
            <h2 id="achievements-title">Mathematical modelling and competition.</h2>
          </div>
          <p class="section-note">Team modelling has taught me to turn an open question into assumptions, a model, and a clear argument.</p>
        </div>
        <ol class="achievement-list">
          {achievements.map((achievement, index) => (
            <li>
              <span class="achievement-number">{String(index + 1).padStart(2, "0")}</span>
              <strong>{achievement.award}</strong>
              <span>{achievement.context}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="now section page-width" id="now" aria-labelledby="now-title">
        <div class="section-heading compact-heading">
          <div>
            <p class="eyebrow">04 · Current work</p>
            <h2 id="now-title">What I am still building.</h2>
          </div>
          <p class="section-note">These are ongoing projects rather than a finished activity record.</p>
        </div>
        <div class="now-grid">
          <article class="now-card">
            <Image
              src={metabolisCover}
              alt="Pixel-art roads and vehicles from Metabolis"
              widths={[520, 760]}
              sizes="(max-width: 720px) 100vw, 50vw"
              loading="lazy"
            />
            <div>
              <p class="eyebrow">Game design</p>
              <h3>Metabolis</h3>
              <p>A strategy game that turns biological circulation and infrastructure into an evolving pixel-art city.</p>
            </div>
          </article>
          <article class="now-card">
            <Image
              src={cyclingRoute}
              alt="A privacy-cropped cycling route through Shenzhen"
              widths={[520, 760]}
              sizes="(max-width: 720px) 100vw, 50vw"
              loading="lazy"
            />
            <div>
              <p class="eyebrow">Cycling log</p>
              <h3>327.3 km across 17 rides</h3>
              <p>A personal record of routes through Shenzhen, kept as a visual archive rather than a performance feed.</p>
            </div>
          </article>
        </div>
      </section>

      <section class="glimpses section page-width" aria-labelledby="glimpses-title">
        <div class="section-heading compact-heading">
          <div>
            <p class="eyebrow">05 · Glimpses</p>
            <h2 id="glimpses-title">Outside the work.</h2>
          </div>
          <p class="section-note">A small selection of photographs. The complete gallery is part of the interactive room.</p>
        </div>
        <div class="glimpse-grid">
          {gallery.map((photo, index) => (
            <Image
              src={photo}
              alt=""
              widths={[260, 400]}
              sizes="(max-width: 720px) 46vw, 22vw"
              loading={index === 0 ? "eager" : "lazy"}
            />
          ))}
        </div>
      </section>

      <section class="room-invitation page-width" aria-labelledby="room-title">
        <div>
          <p class="eyebrow">Optional exploration</p>
          <h2 id="room-title">Prefer a more personal way to explore?</h2>
        </div>
        <div>
          <p>The interactive room is a separate visual journey through the same work, projects, certificates, and photographs.</p>
          <a class="button primary" href="/interactive">Enter the interactive room <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer page-width">
      <p>Yanlang Liu · Shenzhen, China</p>
      <a href="#top">Back to top ↑</a>
    </footer>

    <script>
      const supportsFinePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      if (supportsFinePointer.matches && !prefersReducedMotion.matches) {
        document.body.classList.add("has-pointer-glow");

        window.addEventListener(
          "pointermove",
          (event) => {
            document.documentElement.style.setProperty("--pointer-x", `${event.clientX}px`);
            document.documentElement.style.setProperty("--pointer-y", `${event.clientY}px`);
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { --display-font: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; --meta-font: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace; background: #faf6f1; }
  .cursor-glow { position: fixed; z-index: 0; inset: 0; pointer-events: none; opacity: 0; background: radial-gradient(360px circle at var(--pointer-x, 50vw) var(--pointer-y, -20vh), rgb(200 85 47 / 8%), transparent 70%); transition: opacity 280ms ease; }
  :global(body.has-pointer-glow) .cursor-glow { opacity: 1; }
  :global(body) > :not(.cursor-glow) { position: relative; z-index: 1; }
  .page-width { width: min(1160px, calc(100% - 56px)); margin: 0 auto; }
  .site-header { position: sticky; z-index: 10; top: 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; width: min(1240px, calc(100% - 40px)); min-height: 54px; margin: 0 auto; border-bottom: 1px solid #e8e0d6; background: color-mix(in srgb, #faf6f1 94%, transparent); backdrop-filter: blur(14px); }
  .wordmark { width: max-content; font-weight: 800; font-size: .9rem; letter-spacing: -.07em; }
  nav { display: flex; gap: 22px; font-size: .75rem; }
  nav a, .room-link, .site-footer a { transition: color 180ms ease; }
  nav a:hover, .room-link:hover, .site-footer a:hover { color: #c8552f; }
  .room-link { justify-self: end; font-size: .75rem; font-weight: 650; }
  .eyebrow { margin: 0; color: #8a817a; font-family: var(--meta-font); font-size: .65rem; font-weight: 700; letter-spacing: .07em; line-height: 1.45; text-transform: uppercase; }
  .hero { position: relative; display: flex; flex-direction: column; justify-content: center; min-height: min(474px, calc(100svh - 54px)); padding: 38px 0 30px; border-bottom: 1px solid #e8e0d6; isolation: isolate; }
  .hero::after { position: absolute; z-index: -1; right: 4%; bottom: 26%; width: clamp(140px, 16vw, 220px); height: clamp(100px, 12vw, 164px); content: ""; background: linear-gradient(135deg, rgb(213 168 74 / 25%), rgb(200 85 47 / 12%)); transform: rotate(-5deg); }
  .hero-copy { display: grid; grid-template-columns: minmax(0, 1.38fr) minmax(220px, .62fr); gap: 28px; align-items: end; margin-top: 12px; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2, h3 { letter-spacing: -.05em; }
  h1 { position: relative; z-index: 1; margin-bottom: 0; color: #131211; font-family: var(--display-font); font-size: clamp(4.25rem, 10vw, 8.6rem); font-weight: 700; letter-spacing: -.075em; line-height: .74; text-shadow: .045em .045em 0 #e7c9b6, .09em .09em 0 rgb(213 168 74 / 38%); }
  h2 { max-width: 720px; margin-bottom: 0; font-family: var(--display-font); font-size: clamp(2.1rem, 4.1vw, 3.55rem); font-weight: 700; letter-spacing: -.06em; line-height: .88; }
  h3 { margin-bottom: 5px; font-size: clamp(1.42rem, 2.15vw, 1.95rem); line-height: .98; }
  .hero-statement { max-width: 350px; margin: 0 0 1px; color: #554f49; font-size: clamp(1rem, 1.45vw, 1.18rem); line-height: 1.42; }
  .hero-details { display: flex; gap: 36px; margin-top: 32px; color: #8a817a; font-family: var(--meta-font); font-size: .69rem; line-height: 1.55; }
  .hero-details p { margin-bottom: 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 21px; }
  .button { display: inline-flex; align-items: center; gap: 10px; width: max-content; min-height: 36px; padding: 0 13px; border: 1px solid #131211; font-size: .72rem; font-weight: 700; transition: background 180ms ease, color 180ms ease, transform 180ms ease; }
  .button:hover { transform: translateY(-2px); }
  .button.primary { background: #131211; color: #faf6f1; }
  .button.primary:hover { border-color: #c8552f; background: #c8552f; }
  .button.secondary:hover { border-color: #c8552f; color: #c8552f; }
  .section { padding: 54px 0; border-top: 1px solid #e8e0d6; }
  .about { padding-top: 40px; padding-bottom: 42px; border-top: 0; }
  .section-intro { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(260px, .9fr); gap: 34px; align-items: start; margin-top: 12px; }
  .section-intro > p { margin: 3px 0 0; color: #554f49; font-size: .94rem; line-height: 1.58; }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(210px, .5fr); gap: 32px; align-items: end; }
  .section-heading h2 { margin-top: 10px; }
  .section-note { max-width: 280px; justify-self: end; margin: 0 0 2px; color: #8a817a; font-size: .78rem; line-height: 1.5; }
  .work-list { margin-top: 28px; }
  .work-item { display: grid; grid-template-columns: minmax(185px, .5fr) minmax(0, 1.5fr); gap: clamp(24px, 3.5vw, 46px); align-items: start; padding: 14px 0; border-top: 1px solid #e8e0d6; transition: background 220ms ease, padding 220ms ease; }
  .work-item:last-child { border-bottom: 1px solid #e8e0d6; }
  .work-image { background: #eee7df; }
  .work-image { overflow: hidden; }
  .work-image :global(img) { display: block; width: 100%; aspect-ratio: 1.58 / 1; object-fit: cover; transition: transform 420ms cubic-bezier(.2, .65, .2, 1); }
  .work-context { margin-bottom: 8px; color: #8a817a; font-family: var(--meta-font); font-size: .65rem; }
  .work-copy > .eyebrow { margin-bottom: 5px; }
  .work-summary { max-width: 670px; margin: 10px 0 7px; font-size: .86rem; line-height: 1.48; }
  .work-role { max-width: 720px; margin-bottom: 9px; color: #554f49; font-size: .76rem; line-height: 1.42; }
  .tag-list { display: flex; flex-wrap: wrap; gap: 5px; padding: 0; margin: 0; list-style: none; }
  .tag-list li { padding: 3px 6px; border: 1px solid #e0d7cd; color: #8a817a; font-family: var(--meta-font); font-size: .59rem; }
  .achievement-list { padding: 0; margin: 28px 0 0; list-style: none; }
  .achievement-list li { display: grid; grid-template-columns: 54px minmax(160px, .7fr) minmax(200px, 1.3fr); gap: 14px; align-items: baseline; padding: 11px 0; border-top: 1px solid #e8e0d6; transition: background 180ms ease, color 180ms ease; }
  .achievement-list li:last-child { border-bottom: 1px solid #e8e0d6; }
  .achievement-number { color: #c8552f; font-family: var(--meta-font); font-size: .65rem; font-weight: 700; }
  .achievement-list strong { font-size: .9rem; }
  .achievement-list span:last-child { color: #8a817a; font-family: var(--meta-font); font-size: .65rem; line-height: 1.5; }
  .now-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 28px; }
  .now-card { display: grid; grid-template-rows: auto 1fr; border: 1px solid #e8e0d6; background: #fffdfa; overflow: hidden; transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease; }
  .now-card :global(img) { display: block; width: 100%; aspect-ratio: 1.88 / 1; border-bottom: 1px solid #e8e0d6; object-fit: cover; transition: transform 420ms cubic-bezier(.2, .65, .2, 1); }
  .now-card > div { padding: 15px 16px 16px; }
  .now-card .eyebrow { margin-bottom: 5px; }
  .now-card h3 { font-size: 1.36rem; }
  .now-card p:last-child { max-width: 420px; margin: 8px 0 0; color: #554f49; font-size: .77rem; line-height: 1.42; }
  .glimpse-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; margin-top: 28px; }
  .glimpse-grid :global(img) { display: block; width: 100%; aspect-ratio: 1.04; object-fit: cover; transition: filter 220ms ease, transform 320ms cubic-bezier(.2, .65, .2, 1); }
  .room-invitation { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(260px, .55fr); gap: 38px; align-items: end; padding: 46px 0; border-top: 1px solid #e8e0d6; }
  .room-invitation h2 { margin-top: 10px; font-size: clamp(1.95rem, 3.6vw, 3rem); }
  .room-invitation > div:last-child > p { margin: 0 0 15px; color: #554f49; font-size: .82rem; line-height: 1.48; }
  .site-footer { display: flex; justify-content: space-between; gap: 24px; padding: 16px 0 18px; border-top: 1px solid #e8e0d6; color: #8a817a; font-family: var(--meta-font); font-size: .64rem; }
  .site-footer p { margin-bottom: 0; }
  @media (max-width: 720px) {
    .page-width { width: min(100% - 32px, 540px); }
    .site-header { grid-template-columns: 1fr auto; width: min(100% - 28px, 570px); min-height: 50px; }
    .site-header nav { display: none; }
    .compact-room-link { font-size: .72rem; }
    .hero { min-height: min(458px, calc(100svh - 50px)); padding: 31px 0 26px; }
    .hero::after { right: 0; bottom: 21%; }
    .hero-copy, .section-intro, .section-heading, .room-invitation { grid-template-columns: 1fr; gap: 18px; }
    h1 { font-size: clamp(4rem, 19vw, 5.6rem); text-shadow: .04em .04em 0 #e7c9b6, .08em .08em 0 rgb(213 168 74 / 34%); }
    h2 { font-size: clamp(2rem, 10.5vw, 3rem); }
    .hero-details { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 26px; }
    .section { padding: 42px 0; }
    .about { padding-top: 32px; padding-bottom: 34px; }
    .section-note { justify-self: start; margin: 0; }
    .work-list, .achievement-list, .now-grid, .glimpse-grid { margin-top: 22px; }
    .work-item { grid-template-columns: 1fr; gap: 11px; padding: 12px 0 15px; }
    .work-image :global(img) { aspect-ratio: 1.55 / 1; }
    .achievement-list li { grid-template-columns: 42px 1fr; gap: 8px 12px; }
    .achievement-list span:last-child { grid-column: 2; }
    .now-grid { grid-template-columns: 1fr; gap: 14px; }
    .now-card > div { padding: 14px; }
    .glimpse-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .room-invitation { gap: 18px; padding: 36px 0; }
    .site-footer { padding-bottom: 22px; }
  }
  @media (hover: hover) and (pointer: fine) {
    nav a { position: relative; }
    nav a::after { position: absolute; right: 0; bottom: -7px; left: 0; height: 1px; content: ""; background: currentcolor; transform: scaleX(0); transform-origin: right; transition: transform 180ms ease; }
    nav a:hover::after { transform: scaleX(1); transform-origin: left; }
    .work-item:hover { padding-right: 12px; padding-left: 12px; background: rgb(255 253 250 / 65%); }
    .work-item:hover .work-image :global(img), .now-card:hover :global(img) { transform: scale(1.035); }
    .work-item:hover .eyebrow, .achievement-list li:hover .achievement-number { color: #c8552f; }
    .achievement-list li:hover { padding-right: 10px; padding-left: 10px; background: rgb(255 253 250 / 65%); }
    .now-card:hover { border-color: #c8552f; box-shadow: 0 16px 30px rgb(56 42 31 / 10%); transform: translateY(-4px); }
    .glimpse-grid :global(img):hover { z-index: 1; filter: saturate(1.08); transform: scale(1.045); }
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } .cursor-glow { display: none; } }
</style>
